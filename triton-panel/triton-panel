class ContactStrip(Gtk.DrawingArea):
    """A strip chart of the last seconds of `finger-present`, with each
    enrollment result marked on the same timeline.

    This is the instrument the enrollment window exists for. fprintd says a
    stage was rejected but never says what the hand did; putting "the sensor
    felt the finger for 0.18 s" next to "that one came back too short" is what
    makes the gesture learnable instead of guesswork.

    Deliberately carries NO target speed. The correct dwell for a given sensor
    is not something this panel could honestly claim to know, so it measures
    the user's own attempts and labels the ones that passed -- `last good`
    below is observed, never a constant.

    Degrades honestly: a reader that never reports finger-present says so,
    rather than drawing an empty chart that would read as "your finger was
    never detected".
    """

    WINDOW = 12.0          # seconds of history visible
    HEIGHT = 92
    PAD = 8

    MARK_COLOURS = {
        "stage": (0.25, 0.72, 0.31),
        "done": (0.25, 0.72, 0.31),
        # Calibration only: the capture reached the matcher and lost on score.
        # Deliberately NOT amber -- amber means "change what your hand does",
        # and this result is the one case where the hand did its job.
        "scored": (0.33, 0.56, 0.90),
        "gesture": (0.86, 0.60, 0.10),
        "driver": (0.90, 0.33, 0.29),
        "fatal": (0.90, 0.33, 0.29),
    }

    def __init__(self):
        super().__init__()
        self.set_content_height(self.HEIGHT)
        self.set_hexpand(True)
        # [start, end] in monotonic seconds; end is None while in contact.
        self.contacts = []
        self.marks = []            # (t, kind)
        self.supported = None      # None = no property seen yet
        self.last_good = None      # seconds of the last contact that passed
        self.set_draw_func(self._draw)

    def reset(self):
        self.contacts.clear()
        self.marks.clear()
        self.last_good = None
        self.queue_draw()

    def set_present(self, present):
        """Record a finger-present transition."""
        self.supported = True
        now = time.monotonic()
        if present:
            if not self.contacts or self.contacts[-1][1] is not None:
                self.contacts.append([now, None])
        elif self.contacts and self.contacts[-1][1] is None:
            self.contacts[-1][1] = now
        self.queue_draw()

    def close_open_contact(self):
        """Shut the current contact at this instant and return its length.

        A result can arrive while the driver still reports the finger down, so
        pairing must not wait for the off-transition that may never come.
        """
        if self.contacts and self.contacts[-1][1] is None:
            self.contacts[-1][1] = time.monotonic()
        if self.contacts:
            start, end = self.contacts[-1]
            return (end or time.monotonic()) - start
        return None

    def mark(self, kind, duration=None):
        self.marks.append((time.monotonic(), kind))
        if kind in ("stage", "done") and duration:
            self.last_good = duration
        self.queue_draw()

    def _draw(self, _area, cr, width, height):
        fg = self.get_color()
        cr.select_font_face("monospace")
        cr.set_font_size(11)

        if self.supported is None and not self.contacts:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
            cr.move_to(self.PAD, height / 2 + 4)
            cr.show_text("waiting for the reader to report finger contact")
            return

        now = time.monotonic()
        left, right = self.PAD, width - self.PAD
        span = right - left
        track_top, track_height = 30, 30

        def x_of(t):
            offset = (now - t) / self.WINDOW
            return right - offset * span

        # The track the contact blocks sit in.
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.10)
        cr.rectangle(left, track_top, span, track_height)
        cr.fill()

        # One second grid, so a block's width is readable as a duration.
        for step in range(1, int(self.WINDOW) + 1):
            x = right - (step / self.WINDOW) * span
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.13)
            cr.set_line_width(1)
            cr.move_to(x, track_top)
            cr.line_to(x, track_top + track_height)
            cr.stroke()

        # Contact blocks.
        for start, end in self.contacts:
            finish = end if end is not None else now
            if finish < now - self.WINDOW:
                continue
            x0 = max(left, x_of(start))
            x1 = min(right, x_of(finish))
            if x1 - x0 < 1.5:
                x1 = x0 + 1.5
            live = end is None
            cr.set_source_rgba(0.35, 0.65, 1.00, 0.95 if live else 0.75)
            cr.rectangle(x0, track_top, x1 - x0, track_height)
            cr.fill()

        # Results, on the same time axis as the contact that produced them.
        for t, kind in self.marks:
            if t < now - self.WINDOW:
                continue
            x = x_of(t)
            red, green, blue = self.MARK_COLOURS.get(kind, (0.6, 0.6, 0.6))
            cr.set_source_rgb(red, green, blue)
            cr.set_line_width(2)
            cr.move_to(x, track_top - 6)
            cr.line_to(x, track_top + track_height + 6)
            cr.stroke()
            cr.arc(x, track_top - 9, 3, 0, 2 * math.pi)
            cr.fill()

        # Readout: the live or last contact, and the last one that counted.
        if self.contacts:
            start, end = self.contacts[-1]
            length = (end if end is not None else now) - start
            label = f"{'holding' if end is None else 'last contact'} {length:5.2f}s"
        else:
            label = "no contact yet"
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.85)
        cr.move_to(left, 16)
        cr.show_text(label)

        if self.last_good:
            text = f"last accepted {self.last_good:.2f}s"
            cr.set_source_rgb(0.25, 0.72, 0.31)
            cr.move_to(right - cr.text_extents(text).width, 16)
            cr.show_text(text)

        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.45)
        cr.move_to(left, height - 4)
        cr.show_text(f"{int(self.WINDOW)}s ago")
        text = "now"
        cr.move_to(right - cr.text_extents(text).width, height - 4)
        cr.show_text(text)


class StageDots(Gtk.DrawingArea):
    """`stages` pills, filled as stages pass. Driven only by
    enroll-stage-passed, never by a retry: a rejected attempt genuinely does
    not advance the counter, and showing otherwise would be a lie that makes
    the next failure baffling."""

    HEIGHT = 22

    def __init__(self):
        super().__init__()
        self.set_content_height(self.HEIGHT)
        self.set_hexpand(True)
        self.stages = 0
        self.passed = 0
        self.set_draw_func(self._draw)

    def configure(self, stages):
        self.stages = max(0, int(stages or 0))
        self.passed = 0
        self.queue_draw()

    def set_passed(self, passed):
        self.passed = passed
        self.queue_draw()

    def _draw(self, _area, cr, width, height):
        if self.stages <= 0:
            return
        gap = 6
        pill = (width - gap * (self.stages - 1)) / self.stages
        fg = self.get_color()
        for index in range(self.stages):
            x = index * (pill + gap)
            if index < self.passed:
                cr.set_source_rgb(0.25, 0.72, 0.31)
            else:
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.16)
            radius = height / 2
            cr.new_sub_path()
            cr.arc(x + radius, height / 2, radius, math.pi / 2, 3 * math.pi / 2)
            cr.arc(x + pill - radius, height / 2, radius, 3 * math.pi / 2, math.pi / 2)
            cr.close_path()
            cr.fill()


class EnrollWindow(Adw.Window):
    """The enrollment flow, in a window of its own.

    Why a separate window rather than more rows in the Fingerprint group: this
    is a live interaction that takes many attempts, during which the user is
    looking at their hand and the sensor, not at a settings list. The first
    version reported all of it through one subtitle on a combo row, which is
    how every attempt across three sessions on this machine could fail without
    leaving anything to go on -- the diagnosis had to come from fprintd's own
    journal instead.

    It owns the claim for its whole lifetime. Claim -> EnrollStart ->
    EnrollStop -> Release, and the release runs on EVERY exit path including
    close-request, because a claim left behind means the next Super+L has no
    fingerprint until fprintd times it out.

    Claim is the one async call here. It raises a polkit prompt and blocks for
    as long as the human takes to type a password; doing it synchronously froze
    the window before it had painted a single frame.
    """

    TICK_MS = 50     # 20 fps, only while an enrollment is running

    # A driver fault arrives as a TERMINAL EnrollStatus: fprintd has ended the
    # enrollment, though the claim is still ours. The window restarts it
    # itself rather than sending the user back through polkit, because on this
    # machine that fault lands every few captures and re-authorizing each time
    # is what made a session unworkable. Two caps, for the two shapes seen in
    # `journalctl -u fprintd`:
    #
    #   MAX_DRY_RESTARTS -- a wedged USB endpoint emits the fault back to back
    #       with no finger contact in between. Restarting into that is a spin,
    #       so consecutive restarts with no contact between them are counted
    #       and stop it. (Recovery is ./fp-debug.sh rebind.)
    #   MAX_RESTARTS     -- a hard ceiling, so an unattended window cannot
    #       loop for an hour.
    MAX_RESTARTS = 15
    MAX_DRY_RESTARTS = 3

    # -- calibration gate ---------------------------------------------------- #
    #
    # Added 2026-11-01. Enrolment can pass 6/6 and still produce a template
    # that never matches (§20m), so this window no longer treats "enrolled" as
    # the goal. It measures MATCHING first, with verify -- which writes
    # nothing -- and only then offers to re-enrol.
    #
    # The gate: at least CAL_MIN attempts, and at least CAL_REQUIRED of the
    # last CAL_WINDOW reaching the matcher. A rolling window, not a total, so
    # the score reflects the placement the user has CONVERGED on rather than
    # being dragged down forever by the fumbling at the start -- the whole
    # point is to find a repeatable placement and then enrol from it.
    #
    # Not configurable. A knob here would invite tuning the threshold until it
    # passes, which is the one thing that would make the measurement useless.
    CAL_WINDOW = 10
    CAL_REQUIRED = 8
    CAL_MIN = 10

    # -- what each stage should capture ------------------------------------- #
    #
    # Corrected 2026-11-01 (§20q), and it REVERSES what this window used to
    # say. An enrolled NBIS print is a GPtrArray of per-stage minutiae sets --
    # FpPrint exposes it as `fpi-prints`, plural, and `fpi_print_add_print`
    # appends one per stage -- and `fpi_print_bz3_match` loops over EVERY
    # stored set, returning success on the FIRST one scoring at or above the
    # bz3 threshold (default 40). That is a one-of-N match, not a composite.
    #
    # So six identical placements store six near-duplicates and waste five of
    # the six slots, while six DIFFERENT regions give six independent chances
    # for a single verify capture to overlap one of them. On a ~1 cm pad,
    # where no one capture holds much of the finger, that is the difference
    # between a template that can be matched and one that cannot. It is also
    # why phone enrolment asks you to shift the finger and then do the edges.
    #
    # The window used to say to use the SAME placement on every stage. That
    # conflated two different things: the `elan` driver stitching FRAMES by
    # displacement WITHIN one capture (§20j) with how libfprint stores stages
    # ACROSS an enrolment. The first is real; the second is not stitching.
    ENROLL_REGIONS = [
        "the centre of your fingertip",
        "a little HIGHER, nearer the tip",
        "a little LOWER, nearer the first joint",
        "rolled slightly LEFT",
        "rolled slightly RIGHT",
        "the centre again, held a touch longer",
    ]

    # A calibration run is a deliberate loop, so it has no restart ceiling --
    # the user stops it when they are done. But a wedged endpoint faults back
    # to back with nothing touching the pad, and looping into that is a spin,
    # so consecutive driver faults with no contact between them still stop it.
    MAX_CAL_DRY = 4

    # -- what counts as one measurement ------------------------------------ #
    #
    # Two decisions were coupled in the first version of this (§20r) and they
    # have OPPOSITE failure modes:
    #
    #   * miss a COUNT  -> the measurement is wrong, which is recoverable.
    #   * miss a RE-ARM -> the device is not listening, so the user's touch is
    #                      lost entirely and the hardware looks broken.
    #
    # §20r made the re-arm wait for the lift, so the panel went deaf for up to
    # three seconds after every result. The journals tell the story: before,
    # events every 1-3 s with `No minutiae found` interleaved; after, gaps of
    # 3/4/5/13/14 s and ONE `No minutiae found` in 45 s. Touches were landing
    # in the blackout. Fixed in §20s: the verify is ALWAYS re-armed at once,
    # and the lift gate decides only whether a result is COUNTED.
    #
    # Deciding "is this a new press?" cannot use the strip's open contact,
    # because `close_open_contact()` shuts it artificially on every result --
    # the same trap that made a dozen results from one press each show a
    # plausible duration. It uses instead:
    #
    #   * any finger-present TRANSITION since the last counted result. A new
    #     press must be detected to be captured at all, so the ON edge is the
    #     best evidence available that something moved.
    #   * failing that, a wall-clock escape: a result arriving this long after
    #     the last counted one is counted regardless, so an unreliable
    #     finger-present (this driver emits an INVALID off-transition, §20j)
    #     can never suppress the measurement forever.
    SAME_PRESS_S = 2.0

    def __init__(self, parent, finger, label):
        super().__init__(
            transient_for=parent,
            modal=True,
            title=f"Enroll — {label}",
            default_width=620,
            default_height=760,
        )
        self.parent = parent
        self.device = parent.fp_device
        self.info = parent.fp_info or {}
        self.finger = finger
        self.label = label

        self.stages = self.info.get("stages") or 0
        self.passed = 0
        self.attempts = 0
        self.tally = {}
        self.running = False
        self.completed = False
        self._signal_handler = None
        self._props_handler = None
        self._tick_id = None
        self._saw_contact = False
        self.restarts = 0
        self._dry_restarts = 0
        self._contact_since_restart = False
        self._restart_block = None

        # -- calibration state ---------------------------------------------- #
        # phase is what the claim is currently being used for, and what _stop
        # has to stop: "idle" | "calibrate" | "enroll".
        self.phase = "idle"
        self._pending_phase = None
        self.cal_log = []        # one bool per attempt: did it reach the matcher
        self.cal_tally = {}
        self.cal_attempts = 0
        self.cal_matched = 0
        self._cal_dry = 0
        self._cal_contact = False
        self.calibrated = False
        # Has the finger come OFF since the last counted attempt? True to
        # start, so the first touch of a run counts.
        self._lifted = True
        self._presence_changes = 0
        self._last_counted_at = 0.0
        self._cal_noted_no_lift = False
        self._cal_suppressed = 0
        # Which operation the claim was last used for, and whether the claim
        # has already been given back. Without these a second _stop() asks
        # fprintd to EnrollStop/Release a device it no longer holds, which it
        # logs as "Device was not claimed before use" -- a line that reads
        # exactly like a claim leak and is not one.
        self._last_phase = None
        self._released = False

        # Whether the chosen slot already holds a print. Enrolling into an
        # occupied slot OVERWRITES it, and the print on this machine took
        # three sessions to get, so the window says so instead of discovering
        # it afterwards.
        self.slot_taken = finger in (getattr(parent, "_fp_fingers", None) or [])

        # Set the moment the window starts going away, so the async Claim
        # callback can tell it is arriving into a dead window.
        self._closed = False

        self.usb_id, self.usb_power = reader_usb()
        self._build()
        self.connect("close-request", self._on_close_request)

    # -- construction ------------------------------------------------------- #

    def _build(self):
        self.toasts = Adw.ToastOverlay()
        bars = Adw.ToolbarView()
        bars.add_top_bar(Adw.HeaderBar())

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        body.set_margin_top(14)
        body.set_margin_bottom(14)
        body.set_margin_start(14)
        body.set_margin_end(14)

        # A driver/sensor mismatch is not the user's problem to solve, so it is
        # said once, up front, instead of being discovered after twenty swipes.
        # No pre-emptive "known driver problem" banner. It used to warn that
        # enrolment "may fail with a driver fault no gesture can fix" -- which
        # 2026-11-01 disproved: 6/6 with two rejections and zero protocol
        # errors, once the instructions matched the pad. The protocol errors
        # are intermittent, not blocking, and a standing warning about them
        # told the user nothing they could act on. Per-result reporting in
        # _handle_result already says whose problem each attempt was.

        # The status line is the window's headline and belongs to whichever
        # phase is running, so it sits ABOVE everything rather than inside a
        # card. It used to live in the Stages card, which is how adding the
        # calibration phase left that card inert and full of calibration text
        # -- see §20o's defect note.
        body.append(self._status_box())
        body.append(self._card("Finger contact", self._contact_card()))
        body.append(self._card("Placement calibration", self._calibration_card()))
        body.append(self._progress_card())
        body.append(self._card("Live reader state", self._live_card()))
        body.append(self._guide())
        body.append(self._card("Attempts", self._log_card()))

        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(body)
        scroller.set_vexpand(True)
        bars.set_content(scroller)

        bottom = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bottom.set_margin_top(8)
        bottom.set_margin_bottom(8)
        bottom.set_margin_start(12)
        bottom.set_margin_end(12)
        # Calibrate is the suggested action, not enrol: measuring is what you
        # should do first and it is the one that cannot damage anything.
        self.cal_button = Gtk.Button(label="Calibrate placement")
        self.cal_button.add_css_class("suggested-action")
        self.cal_button.connect("clicked", self._on_calibrate)
        self.start_button = Gtk.Button(label="Enroll anyway")
        self.start_button.connect("clicked", self._on_start)
        self.stop_button = Gtk.Button(label="Stop")
        self.stop_button.set_sensitive(False)
        self.stop_button.connect("clicked", self._on_stop_clicked)
        spacer = Gtk.Box()
        spacer.set_hexpand(True)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _b: self.close())
        for widget in (self.cal_button, self.start_button, self.stop_button,
                       spacer, close):
            bottom.append(widget)
        bars.add_bottom_bar(bottom)

        self.toasts.set_child(bars)
        self.set_content(self.toasts)
        # Both of these paint widgets built above, so they run last: _update_cal
        # needs the buttons, _set_idle_text needs stages_note.
        self._update_cal()
        self._set_idle_text()

    @staticmethod
    def _card(title, child):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        heading = Gtk.Label(label=title, xalign=0.0)
        heading.add_css_class("heading")
        box.append(heading)
        frame = Adw.Bin()
        frame.add_css_class("card")
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        inner.set_margin_top(10)
        inner.set_margin_bottom(10)
        inner.set_margin_start(10)
        inner.set_margin_end(10)
        inner.append(child)
        frame.set_child(inner)
        box.append(frame)
        return box

    def _contact_card(self):
        self.strip = ContactStrip()
        return self.strip

    def _calibration_card(self):
        """Measure matching before touching the stored print.

        This card is the answer to the failure mode of 2026-11-01: a 6/6
        enrolment whose template then matched nothing, with every number in
        this window still reading as success. Enrolment signals cannot see
        that; only verify can.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        self.cal_status = Gtk.Label(xalign=0.0, wrap=True)
        self.cal_status.add_css_class("title-4")
        box.append(self.cal_status)

        self.cal_meter = Gtk.Label(xalign=0.0, wrap=True)
        self.cal_meter.add_css_class("numeric")
        box.append(self.cal_meter)

        self.cal_detail = Gtk.Label(xalign=0.0, wrap=True)
        self.cal_detail.add_css_class("dim-label")
        box.append(self.cal_detail)

        # The per-result breakdown. It was being collected into cal_tally
        # from the first version and rendered nowhere -- the Stages card's
        # tally_label reads the ENROLMENT tally, so during calibration it
        # stayed empty. Part of the same §20o defect.
        self.cal_tally_label = Gtk.Label(xalign=0.0, wrap=True)
        self.cal_tally_label.add_css_class("dim-label")
        self.cal_tally_label.add_css_class("caption")
        box.append(self.cal_tally_label)

        self.cal_note = Gtk.Label(xalign=0.0, wrap=True)
        self.cal_note.add_css_class("dim-label")
        self.cal_note.add_css_class("caption")
        self.cal_note.set_text(
            "Calibration runs verify against the print already stored. It "
            "enrolls nothing, deletes nothing and writes nothing, so it is "
            "safe to repeat. \"Scored\" means the sensor got readable ridges "
            "and the matcher ran -- it is evidence about your placement, not "
            "a quality score for the image; only ./fp-debug.sh verify prints "
            "the underlying minutiae count."
        )
        box.append(self.cal_note)

        if self.slot_taken:
            warn = Gtk.Label(xalign=0.0, wrap=True)
            warn.add_css_class("warning")
            warn.set_text(
                f"\u26a0 {self.label} already holds a print. Enrolling into "
                "this slot OVERWRITES it. To keep it, close this window and "
                "pick a finger with no print -- the slot name is only a "
                "label, so a free slot can hold the same physical finger."
            )
            box.append(warn)

        # NOT _update_cal() here: this card is built before the bottom bar, so
        # cal_button/start_button do not exist yet. _build() paints it once
        # everything is constructed.
        return box

    def _update_cal_tally(self):
        if not self.cal_tally:
            self.cal_tally_label.set_text("")
            return
        parts = [f"{count}x {name}" for name, count in
                 sorted(self.cal_tally.items(), key=lambda kv: -kv[1])]
        self.cal_tally_label.set_text(
            f"{self.cal_attempts} attempts · " + " · ".join(parts))

    def _cal_gate(self):
        """(ready, scored_recent, window_size). Rolling, not cumulative."""
        recent = self.cal_log[-self.CAL_WINDOW:]
        scored = sum(1 for ok in recent if ok)
        ready = (len(self.cal_log) >= self.CAL_MIN
                 and scored >= self.CAL_REQUIRED)
        return ready, scored, len(recent)

    def _update_cal(self):
        ready, scored, window = self._cal_gate()
        self.calibrated = ready

        if not self.cal_log and self.phase != "calibrate":
            self.cal_status.set_text("Not measured")
            self.cal_meter.set_text("")
            self.cal_detail.set_text(
                "Press Calibrate placement. Touch the pad the same way you "
                f"would to unlock, {self.CAL_MIN}+ times, and this will show "
                "whether the sensor is giving the matcher anything to work "
                "with."
            )
        else:
            bar = "".join("\u25cf" if ok else "\u25cb"
                          for ok in self.cal_log[-self.CAL_WINDOW:])
            self.cal_meter.set_text(
                f"{bar}   {scored}/{window} scored"
                + (f"   ({self.cal_matched} matched)" if self.cal_matched else "")
            )
            if self.cal_matched:
                self.cal_status.set_text("Matching works")
                self.cal_detail.set_text(
                    f"{self.cal_matched} of {self.cal_attempts} attempts "
                    "matched the stored print, so there is nothing to "
                    "re-enroll for. A match is what hyprlock waits for at the "
                    "lock screen -- this measured fprintd's answer, not "
                    "hyprlock's, but they drive the same verify."
                )
            elif ready:
                self.cal_status.set_text("Calibrated \u2014 and nothing matched")
                self.cal_detail.set_text(
                    f"{scored} of the last {window} captures reached the "
                    "matcher, so your placement is delivering readable "
                    "ridges, and none of them matched the stored print. That "
                    "points at the TEMPLATE, not your hand: re-enrolling is "
                    "worth doing. Enrol AROUND this placement: the same "
                    "quality of contact, a different part of the finger each "
                    "stage, since any one stage matching is enough to unlock."
                )
            elif len(self.cal_log) < self.CAL_MIN:
                self.cal_status.set_text("Measuring\u2026")
                self.cal_detail.set_text(
                    f"{len(self.cal_log)} of {self.CAL_MIN} attempts needed "
                    "before this means anything. Same spot, flat, centred, "
                    "still until the result appears, then lift clear."
                )
            else:
                self.cal_status.set_text("Captures are too thin")
                self.cal_detail.set_text(
                    f"Only {scored} of the last {window} reached the matcher "
                    f"({self.CAL_REQUIRED} needed). Either the placement is "
                    "not repeatable yet, or this is the small-sensor ceiling. "
                    "Re-enrolling from captures this thin would just build "
                    "another template that cannot be matched -- keep "
                    "adjusting, and if it will not come up, run "
                    "./fp-debug.sh verify for the minutiae counts."
                )

        # Guarded: _update_cal is reachable from the card constructor in any
        # future reorder of _build, and the buttons are made after the cards.
        start = getattr(self, "start_button", None)
        cal = getattr(self, "cal_button", None)
        if self.phase == "idle" and start is not None and cal is not None:
            start.set_label("Enroll now" if ready else "Enroll anyway")
            if ready:
                start.add_css_class("suggested-action")
                cal.remove_css_class("suggested-action")
            else:
                start.remove_css_class("suggested-action")
                cal.add_css_class("suggested-action")

    def _status_box(self):
        """The window's one status line, shared by both phases.

        Owned by whichever phase is running. Keeping it out of a card is the
        point: when it lived inside the one titled "Stages", a calibration
        retry message ("the capture had no readable ridges") rendered under a
        heading about enrolment stages, and the Stages card itself sat frozen
        at 0 / 6 looking broken.
        """
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.status_label = Gtk.Label(xalign=0.0, wrap=True)
        self.status_label.add_css_class("title-4")
        box.append(self.status_label)
        self.hint_label = Gtk.Label(xalign=0.0, wrap=True)
        self.hint_label.add_css_class("dim-label")
        box.append(self.hint_label)
        return box

    def _progress_card(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        heading = Gtk.Label(label="Stages", xalign=0.0)
        heading.add_css_class("heading")
        heading.set_hexpand(True)
        self.count_label = Gtk.Label(xalign=1.0)
        self.count_label.add_css_class("numeric")
        self.count_label.add_css_class("dim-label")
        head.append(heading)
        head.append(self.count_label)
        box.append(head)

        self.dots = StageDots()
        self.dots.configure(self.stages)
        box.append(self.dots)

        # Says why the pills are not moving, instead of leaving the card to
        # read as broken whenever an enrollment is not the thing running.
        self.stages_note = Gtk.Label(xalign=0.0, wrap=True)
        self.stages_note.add_css_class("dim-label")
        self.stages_note.add_css_class("caption")
        box.append(self.stages_note)

        self.tally_label = Gtk.Label(xalign=0.0, wrap=True)
        self.tally_label.add_css_class("dim-label")
        self.tally_label.add_css_class("caption")
        box.append(self.tally_label)

        return box

    def _live_card(self):
        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.present_label = Gtk.Label(xalign=0.0)
        self.needed_label = Gtk.Label(xalign=0.0)
        self.device_label = Gtk.Label(xalign=0.0, wrap=True)
        self.device_label.add_css_class("dim-label")
        self.device_label.add_css_class("caption")
        for widget in (self.present_label, self.needed_label, self.device_label):
            grid.append(widget)
        self._render_live(None, None)
        detail = f"{self.info.get('name', 'reader')} · {self.info.get('scan_type', '?')}"
        if self.info.get("driver_scan_type_wrong"):
            detail += f" (driver's claim; the pad is {self.info['gesture']})"
        if self.usb_id:
            detail += f" · {self.usb_id}"
        if self.usb_power:
            detail += f" · USB power/control={self.usb_power}"
        self.device_label.set_text(detail)
        return grid

    def _guide(self):
        expander = Gtk.Expander(label="How this works")
        swipe = self.info.get("gesture") == "swipe"
        stages = self.stages or "several"
        header = (f"This reader needs {stages} accepted captures. The driver "
                  f"declares it a {self.info.get('scan_type', '?')} sensor")
        if self.info.get("driver_scan_type_wrong"):
            header += (", and that is wrong: the part in this chassis is a "
                       "small square pad in the corner of the touchpad, with "
                       "nothing to slide a finger along. What follows "
                       "describes the pad, not the driver")
        text = (
            header + ".\n\n"
            + ("Slide the finger across the sensor in one continuous motion. "
               "The driver stitches a series of frames together as the finger "
               "moves, so a tap produces too few frames to assemble.\n\n"
               "Then lift the finger right off before the next one. libfprint "
               "will not start a capture until the driver has reported the "
               "finger gone, so a finger left resting there stalls the run "
               "silently.\n\n"
               if swipe else
               "Place the finger flat on the sensor, covering as much of it "
               "as you can, hold still until the result appears, then lift it "
               "off completely before the next capture.\n\n"
               "That last step is not optional: libfprint will not begin the "
               "next capture until the driver has reported the finger gone, "
               "so a finger left resting on the pad stalls the run with no "
               "message at all.\n\n")
            + f"A rejected attempt does NOT advance the counter, so reaching "
              f"{stages} of {stages} can take more tries than that. The strip "
              "at the top shows how long the sensor actually felt your finger "
              "on each attempt, with a green mark where one was accepted and "
              "an amber or red mark where it was not — compare the widths to "
              "find what works on your hand.\n\n"
            "Amber marks are gestures you can change. Red marks are the driver "
            "failing to talk to the sensor, which no gesture will fix."
        )
        label = Gtk.Label(label=text, xalign=0.0, wrap=True)
        label.add_css_class("dim-label")
        label.set_margin_top(8)
        label.set_margin_start(4)
        label.set_margin_end(4)
        expander.set_child(label)
        return expander

    def _log_card(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.log_list = Gtk.ListBox()
        self.log_list.add_css_class("boxed-list")
        self.log_list.set_selection_mode(Gtk.SelectionMode.NONE)
        placeholder = Gtk.Label(label="Nothing yet", xalign=0.0)
        placeholder.add_css_class("dim-label")
        placeholder.set_margin_top(8)
        placeholder.set_margin_bottom(8)
        self.log_list.set_placeholder(placeholder)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_min_content_height(150)
        scroller.set_child(self.log_list)
        box.append(scroller)
        return box

    # -- small renderers ---------------------------------------------------- #

    def _set_idle_text(self):
        self.count_label.set_text(f"\u2014 / {self.stages or '?'}")
        self.status_label.set_text("Ready when you are")
        # Names the buttons that exist. It used to say "Press Start", which was
        # the button's name before calibration split it into two.
        self.hint_label.set_text(
            "Press Calibrate placement first — it measures whether a "
            "stored print can be matched at all, and writes nothing. Enroll "
            "once it says your placement is scoring."
        )
        self.tally_label.set_text("")
        self._set_stages_note()

    def _set_stages_note(self):
        """Why the stage pills are or are not moving, in one line."""
        if self.phase == "enroll":
            self.stages_note.set_text("")
        elif self.completed or self.passed:
            self.stages_note.set_text("")
        elif self.phase == "calibrate":
            self.stages_note.set_text(
                "Not in use — calibration measures matching and captures "
                "no stages. These fill in during enrolment.")
        else:
            self.stages_note.set_text(
                "One pill per accepted capture; they fill in during "
                "enrolment.")

    def _render_live(self, present, needed):
        def dot(value, yes, no, unknown):
            if value is None:
                return f"○  {unknown}"
            return f"●  {yes}" if value else f"○  {no}"

        self.present_label.set_text(
            dot(present, "Finger on the sensor", "No finger on the sensor",
                "Finger contact: not reported yet"))
        self.needed_label.set_text(
            dot(needed, "Reader is waiting for a finger", "Reader is not asking "
                "for a finger", "Reader state: not reported yet"))

    def _toast(self, message, timeout=5):
        toast = Adw.Toast(title=message)
        toast.set_timeout(timeout)
        self.toasts.add_toast(toast)

    def _add_log(self, kind, title, detail):
        icons = {"stage": "✓", "done": "✓", "gesture": "!",
                 "scored": "◐", "driver": "✗", "fatal": "✗",
                 "info": "·"}
        css = {"stage": "success", "done": "success", "gesture": "warning",
               "scored": "accent", "driver": "error", "fatal": "error"}
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row.set_margin_top(7)
        row.set_margin_bottom(7)
        row.set_margin_start(10)
        row.set_margin_end(10)

        stamp = Gtk.Label(label=time.strftime("%H:%M:%S"), xalign=0.0)
        stamp.add_css_class("dim-label")
        stamp.add_css_class("numeric")
        mark = Gtk.Label(label=icons.get(kind, "·"))
        if kind in css:
            mark.add_css_class(css[kind])
        text = Gtk.Label(label=title if not detail else f"{title} — {detail}",
                         xalign=0.0, wrap=True)
        text.set_hexpand(True)
        for widget in (stamp, mark, text):
            row.append(widget)
        self.log_list.prepend(row)
        _log(f"{kind}: {title}{(' — ' + detail) if detail else ''}")

    def _update_tally(self):
        if not self.tally:
            self.tally_label.set_text("")
            return
        parts = [f"{count}x {name}" for name, count in
                 sorted(self.tally.items(), key=lambda kv: -kv[1])]
        prefix = f"{self.attempts} attempts"
        if self.restarts:
            prefix += (f" · {self.restarts} restart"
                       f"{'s' if self.restarts != 1 else ''}")
        self.tally_label.set_text(prefix + " · " + " · ".join(parts))

    # -- the enrollment ----------------------------------------------------- #

    def _stages_now(self):
        """num-enroll-stages straight off the bus.

        The spec says this property is only defined once the device has been
        claimed, so it is re-read here rather than trusted from the unclaimed
        cache. An explicit Properties.Get, not get_cached_property: the
        PropertiesChanged that the claim triggers has not necessarily been
        dispatched by the time the synchronous Claim call returns.
        """
        try:
            value = self.device.get_connection().call_sync(
                FPRINT_NAME, self.device.get_object_path(),
                "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", (FPRINT_NAME + ".Device",
                                      "num-enroll-stages")),
                GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None,
            ).unpack()[0]
            return int(value) if int(value) > 0 else 0
        except (GLib.Error, TypeError, ValueError, AttributeError):
            return 0

    def _on_calibrate(self, _button):
        self._claim_for("calibrate")

    def _on_start(self, _button):
        self._claim_for("enroll")

    def _claim_for(self, phase):
        """One claim path for both phases; _on_claimed dispatches on it.

        The claim itself is identical -- same polkit action, same device -- so
        what differs is only which operation it is then used for. Keeping one
        path means the close-while-polkit-is-up release invariant below is
        implemented once rather than twice.
        """
        if self.running or self.device is None:
            return
        self._pending_phase = phase
        self.cal_button.set_sensitive(False)
        self.start_button.set_sensitive(False)
        self.status_label.set_text("Authorizing…")
        self.hint_label.set_text(
            "polkit is asking for your password to claim the reader.")
        self._add_log("info", "Claiming the reader",
                      "to calibrate" if phase == "calibrate" else "to enroll")
        # Async: this call waits on a human typing a password, and a sync call
        # here froze the window before it had painted.
        self.device.call(
            "Claim", GLib.Variant("(s)", (os.environ.get("USER", ""),)),
            Gio.DBusCallFlags.NONE, 120000, None, self._on_claimed, None,
        )

    def _on_claimed(self, proxy, result, _data):
        try:
            proxy.call_finish(result)
        except GLib.Error as error:
            if self._closed:
                return
            self.status_label.set_text("Could not claim the reader")
            self.hint_label.set_text(error.message or "")
            self._add_log("driver", "Claim failed", error.message or "")
            self._idle_buttons()
            return

        # The window can be closed while polkit's password dialog is still up.
        # The claim is granted anyway -- cancelling the Gio call would not stop
        # fprintd from granting it server-side -- so this callback can arrive
        # after teardown, against widgets that are gone and a parent that has
        # already been told the enrollment finished. Release and get out: by
        # the time close-request ran there was nothing to release yet, so this
        # is the only place that can honour the claim/release invariant.
        if self._closed:
            try:
                self.device.call_sync("Release", None, Gio.DBusCallFlags.NONE,
                                      5000, None)
            except GLib.Error:
                pass
            _log("claim granted after the window closed -- released")
            return

        stages = self._stages_now()
        if stages and stages != self.stages:
            self._add_log("info", "Stages reported after claim",
                          f"{stages} (was {self.stages or 'unknown'})")
            self.stages = stages
            self.info["stages"] = stages
        self.dots.configure(self.stages)
        self.strip.reset()
        self._saw_contact = False

        self._released = False
        self._props_handler = self.device.connect(
            "g-properties-changed", self._on_properties_changed)
        self._signal_handler = self.device.connect("g-signal", self._on_signal)

        if self._pending_phase == "calibrate":
            self._begin_calibrate()
        else:
            self._begin_enroll()

    def _idle_buttons(self):
        """Back to the resting state, with the gate deciding which verb leads."""
        self.phase = "idle"
        self.cal_button.set_sensitive(True)
        self.start_button.set_sensitive(True)
        self.stop_button.set_sensitive(False)
        self._update_cal()
        self._set_stages_note()

    def _begin_enroll(self):
        self.passed = 0
        self.attempts = 0
        self.tally.clear()
        self.restarts = 0
        self._dry_restarts = 0
        self._contact_since_restart = False
        self._restart_block = None

        try:
            self.device.call_sync("EnrollStart", GLib.Variant("(s)", (self.finger,)),
                                  Gio.DBusCallFlags.NONE, 10000, None)
        except GLib.Error as error:
            self._add_log("driver", "EnrollStart failed", error.message or "")
            self.status_label.set_text("Enrollment did not start")
            self.hint_label.set_text(error.message or "")
            self._stop(release=True)
            self._idle_buttons()
            return

        self.phase = "enroll"
        self.running = True
        self.stop_button.set_sensitive(True)
        self._set_stages_note()
        verb = "Swipe" if self.info.get("gesture") == "swipe" else "Press"
        self.count_label.set_text(f"0 / {self.stages or '?'}")
        self.status_label.set_text(f"{verb} your {self.label.lower()} finger")
        first = self._region_for(0) or "the centre of your fingertip"
        if self.calibrated:
            self.hint_label.set_text(
                f"Start with {first}. Calibration showed this hand delivers "
                "readable ridges, so keep that same quality of contact, but "
                "move to a DIFFERENT part of the finger for each stage. Every "
                "stage is stored as its own candidate and unlocking succeeds "
                "if ANY one matches, so coverage is what wins.")
        else:
            self.hint_label.set_text(
                f"Start with {first}, then move to a different part of the "
                "finger for each stage: each is stored separately and any "
                "single match unlocks. The strip above shows how long the "
                "sensor felt your finger and marks what came back.")
        self._add_log("info", "Enrollment started", self.finger)
        self._tick_id = GLib.timeout_add(self.TICK_MS, self._tick)

    def _begin_calibrate(self):
        self.cal_log.clear()
        self.cal_tally.clear()
        self.cal_attempts = 0
        self.cal_matched = 0
        self._cal_dry = 0
        self._cal_contact = False
        self._lifted = True
        self._presence_changes = 0
        self._last_counted_at = 0.0
        self._cal_noted_no_lift = False
        self._cal_suppressed = 0

        if not self._verify_cycle(first=True):
            return

        self.phase = "calibrate"
        self.running = True
        self.stop_button.set_sensitive(True)
        self.count_label.set_text(f"\u2014 / {self.stages or '?'}")
        self.tally_label.set_text("")
        self._set_stages_note()
        self._update_cal_tally()
        self.status_label.set_text("Calibrating — not enrolling")
        self.hint_label.set_text(
            "Touch the pad the way you would to unlock, then lift clear. "
            "Nothing is written; press Stop whenever you like.")
        self._add_log("info", "Calibration started",
                      "VerifyStart(any) — writes nothing")
        self._tick_id = GLib.timeout_add(self.TICK_MS, self._tick)
        self._update_cal()

    def _verify_cycle(self, first=False):
        """VerifyStop (unless first) then VerifyStart("any"). True on success.

        fprintd requires VerifyStop before the next VerifyStart once a
        VerifyStatus has arrived with done = True -- and BOTH `verify-match`
        and `verify-no-match` are done = True. So the practice loop is this
        pair, and the retry results (done = False) must NOT go through it:
        fprintd keeps the verify open for those and is already waiting for the
        next finger. Calling Stop/Start on a retry would throw the operation
        away mid-flight.

        "any" rather than self.finger, which is what `fprintd-verify` with no
        -f does: it scores against EVERY enrolled template, so once a second
        slot holds a fresh print, calibration measures both without being told
        about it. VerifyFingerSelected names whichever one fprintd picked.
        """
        if not first:
            try:
                self.device.call_sync("VerifyStop", None, Gio.DBusCallFlags.NONE,
                                      10000, None)
            except GLib.Error as error:
                # Not fatal on its own: the next VerifyStart is the real test.
                _log(f"VerifyStop on cycle: {error.message}")
        try:
            self.device.call_sync("VerifyStart", GLib.Variant("(s)", ("any",)),
                                  Gio.DBusCallFlags.NONE, 10000, None)
        except GLib.Error as error:
            self._add_log("driver", "VerifyStart failed", error.message or "")
            self.status_label.set_text("Calibration did not start")
            self.hint_label.set_text(
                f"{error.message or ''} If this keeps happening the reader may "
                "be wedged — close this window and run "
                "./fp-debug.sh rebind.")
            self._stop(release=True)
            self._idle_buttons()
            return False
        return True

    def _tick(self):
        if not self.running:
            self._tick_id = None
            return False
        self.strip.queue_draw()
        return True

    def _on_properties_changed(self, _proxy, changed, _invalidated):
        values = changed.unpack() if changed is not None else {}
        if "finger-present" in values:
            self._saw_contact = True
            if values["finger-present"]:
                # Distinguishes "the fault keeps interrupting a session the
                # user is actually working" from "the endpoint is wedged and
                # faulting with nothing touching it". See MAX_DRY_RESTARTS
                # and MAX_CAL_DRY.
                self._contact_since_restart = True
                self._cal_contact = True
            else:
                # THE LIFT. Hooked on the real finger-present transition --
                # deliberately NOT on close_open_contact(), which the result
                # handlers call artificially whether or not the finger moved.
                # That is what made a dozen results from one unbroken press
                # look like a dozen placements, each with a plausible contact
                # duration (§20r).
                self._lifted = True
                self._cal_noted_no_lift = False
            # ANY transition means something moved, which is the evidence a
            # new press happened. It never gates the re-arm -- see §20s.
            self._presence_changes += 1
            self.strip.set_present(bool(values["finger-present"]))
        if "finger-present" in values or "finger-needed" in values:
            present = self.device.get_cached_property("finger-present")
            needed = self.device.get_cached_property("finger-needed")
            self._render_live(
                None if present is None else present.unpack(),
                None if needed is None else needed.unpack(),
            )

    def _on_signal(self, _proxy, _sender, signal, params):
        # VerifyFingerSelected is the one signal in this set that is not an
        # outcome -- fprintd emits it before the result to name the template
        # it is about to score against. It must not be counted as an attempt.
        if signal == "VerifyFingerSelected":
            try:
                finger = params.unpack()[0]
            except (TypeError, ValueError, IndexError):
                return
            labels = {name: text for name, text in FINGERS}
            self._add_log("info", "Scoring against",
                          labels.get(finger, finger))
            return

        if signal not in ("EnrollStatus", "VerifyStatus"):
            return
        try:
            result, done = params.unpack()
        except (TypeError, ValueError):
            self._add_log("driver", f"Unreadable {signal}", str(params))
            return
        if signal == "VerifyStatus":
            self._handle_verify_result(result, bool(done))
        else:
            self._handle_result(result, bool(done))

    def _handle_verify_result(self, result, done):
        """One calibration attempt. Writes nothing; never touches a template.

        The loop lives at the bottom: a done = True result has ended fprintd's
        verify, so it is restarted here. See _verify_cycle for why a retry
        (done = False) must not be.
        """
        kind, title, bucket, hint = VERIFY_RESULTS.get(
            result, ("driver", result, "driver",
                     "Not a documented fprintd verify result."))

        # Can this reader tell us when the finger comes off? Only gate on the
        # lift if it can -- a reader that never reports finger-present would
        # otherwise have every result suppressed and calibration would measure
        # nothing at all.
        gated = self.strip.supported is True
        now = time.monotonic()
        quiet = (now - self._last_counted_at) < self.SAME_PRESS_S
        unmoved = gated and not self._lifted and self._presence_changes == 0

        if unmoved and quiet:
            # One unbroken press cannot produce more than one measurement, and
            # counting it again is how the rolling window filled with ten
            # rejects from a single contact (§20r). Note what this branch does
            # NOT do: it does not skip the re-arm below. §20s.
            self._cal_suppressed += 1
            if not self._cal_noted_no_lift:
                self._cal_noted_no_lift = True
                self._add_log("info", "Same contact \u2014 not counted",
                              f"{title}; lift the finger to measure again")
            self.status_label.set_text("Lift the finger clear")
            self.hint_label.set_text(
                "That came from the same press as the last one, so it is not "
                "counted. Take the finger right off the pad, then put it back "
                "down \u2014 the reader will not start a new capture while it "
                "can still feel it.")
            if done and self.running and self.phase == "calibrate":
                self._verify_cycle()
            return

        if unmoved:
            # The escape hatch. finger-present reported nothing for longer than
            # one press can plausibly last, so this is counted rather than
            # suppressed forever -- and said out loud, because "the driver
            # reported a lift" and "we assumed one" must stay distinguishable.
            self._add_log("info", "Counted without a reported lift",
                          f"no finger-present change in "
                          f"{now - self._last_counted_at:.1f}s; see §20j")

        duration = self.strip.close_open_contact()
        self.strip.mark(kind, duration)
        self._lifted = False
        self._presence_changes = 0
        self._last_counted_at = now

        self.cal_attempts += 1
        self.cal_tally[title] = self.cal_tally.get(title, 0) + 1

        # Only placement evidence goes in the rolling window. A driver fault
        # says nothing about the hand, so counting it would drag the score
        # down for something the user cannot act on -- the same conflation
        # that sent §20g chasing the driver for three sessions.
        if bucket == "scored":
            self.cal_log.append(True)
            self._cal_dry = 0
            if result == "verify-match":
                self.cal_matched += 1
        elif bucket == "rejected":
            self.cal_log.append(False)
            self._cal_dry = 0

        detail = hint
        if duration:
            detail = (f"{duration:.2f}s of contact — {hint}" if hint
                      else f"{duration:.2f}s of contact")
        self._add_log(kind, title, detail)
        self._update_cal()
        self._update_cal_tally()

        if not done:
            # fprintd is still waiting for the next finger on the same verify.
            if bucket == "rejected":
                self.hint_label.set_text(f"{hint} {self._cycle_hint()}".strip())
            return

        if not self.running or self.phase != "calibrate":
            return

        if bucket == "driver":
            self._cal_dry = 0 if self._cal_contact else self._cal_dry + 1
            self._cal_contact = False
            if self._cal_dry >= self.MAX_CAL_DRY:
                self.status_label.set_text("The reader is faulting on its own")
                self.hint_label.set_text(
                    f"{self._cal_dry} driver faults in a row with no finger "
                    "contact between them. That is a wedged endpoint, not "
                    "your placement. Close this window and run "
                    "./fp-debug.sh rebind.")
                self._add_log("driver", "Calibration stopped",
                              f"{self._cal_dry} dry faults")
                self._stop(release=True)
                self._idle_buttons()
                return

        # ALWAYS, for every bucket. The device must be listening every moment
        # the user might touch it; whether the result gets COUNTED is decided
        # above and has nothing to do with arming. §20s.
        self._verify_cycle()

    def _region_for(self, index):
        """The region for the 0-based stage `index`, or None past the end.

        Indexed modulo the list, so a device reporting 5 or 8 stages instead
        of this one's 6 still gets a region for every stage.
        """
        if index < 0:
            return None
        if self.stages and index >= self.stages:
            return None
        return self.ENROLL_REGIONS[index % len(self.ENROLL_REGIONS)]

    def _stage_hint(self, duration=None):
        """Lift, then move to a DIFFERENT region for the next stage.

        self.passed has already been incremented, so it is the 0-based index
        of the stage that comes next.
        """
        cycle = self._cycle_hint(duration)
        region = self._region_for(self.passed)
        if region is None:
            return cycle
        return (f"{cycle} For stage {self.passed + 1}, use {region}. Each "
                "stage is stored as its own candidate and unlocking succeeds "
                "if ANY one of them matches, so covering different parts of "
                "the finger is what makes it work.")

    def _cycle_hint(self, duration=None):
        """The instruction libfprint's state machine actually requires.

        This reader goes through libfprint's IMAGE device layer -- the journal
        names its states -- and that layer runs a fixed cycle:

            IDLE -> AWAIT_FINGER_ON -> CAPTURE -> AWAIT_FINGER_OFF -> IDLE

        The next capture cannot begin until the driver has reported the finger
        GONE while in AWAIT_FINGER_OFF. So "lift clear, then go again" is not
        encouragement, it is the protocol: a finger left resting on the sensor
        stalls the run with no error message at all.

        fprintd's own clients say exactly this. enroll_result_str_to_msg() in
        fingerprint-strings.h maps enroll-stage-passed and enroll-retry-scan to
        "Lift then touch again" (press) / "Swipe your finger again" (swipe),
        and gnome-control-center falls back to "Repeatedly lift and place your
        finger on the reader to enroll your fingerprint". This panel was the
        odd one out: it said "once more" without ever saying to lift.
        """
        again = ("swipe again" if self.info.get("gesture") == "swipe"
                 else "touch it again")
        text = (f"Lift the finger clear of the sensor, then {again}. "
                "The reader will not start the next capture while it can "
                "still feel the finger.")
        if duration:
            text += f" That one took {duration:.2f}s of contact."
        return text

    def _handle_result(self, result, done):
        kind, title, hint = ENROLL_RESULTS.get(
            result, ("driver", result, "Not a documented fprintd result."))
        # Pair the result with the contact that produced it. A result can
        # arrive while the driver still reports the finger down, so the contact
        # is closed here rather than waiting for an off-transition that may
        # never come.
        duration = self.strip.close_open_contact()

        if kind == "stage":
            self.passed += 1
            self.dots.set_passed(self.passed)
            self.count_label.set_text(f"{self.passed} / {self.stages or '?'}")
            self.strip.mark("stage", duration)
            self.attempts += 1
            detail = f"stage {self.passed} of {self.stages or '?'}"
            if duration:
                detail += f", {duration:.2f}s of contact"
            self._add_log("stage", "Accepted", detail)
            self.status_label.set_text(
                f"Accepted — {self.passed} of {self.stages or '?'}")
            self.hint_label.set_text(self._stage_hint(duration))
            self._update_tally()
            return

        if not done:
            self.attempts += 1
            self.tally[title] = self.tally.get(title, 0) + 1
            self.strip.mark(kind, duration)
            detail = hint
            if duration:
                detail = f"{duration:.2f}s of contact — {hint}" if hint else f"{duration:.2f}s of contact"
            self._add_log(kind, title, detail)
            # Name the progress on the same line. A bare "No usable detail"
            # sitting there reads as "it stopped", which is how this got
            # reported as the enrollment halting when it had not.
            self.status_label.set_text(
                f"{title} — still going, {self.passed} of "
                f"{self.stages or '?'}")
            if kind == "driver":
                self.hint_label.set_text(
                    f"{hint} This is not your gesture — changing how you move "
                    "the finger will not help.")
            else:
                repeats = self.tally.get(title, 0)
                # Only on enroll-retry-scan. The other gesture results carry
                # their own wording about the finger, and appending the cycle
                # line to them collides: enroll-swipe-too-short says "do not
                # lift partway", enroll-remove-and-retry already says to lift.
                # fprintd maps exactly enroll-retry-scan (and stage-passed) to
                # "Lift then touch again", so match that and no more.
                if result == "enroll-retry-scan":
                    hint = f"{hint} {self._cycle_hint()}".strip()
                self.hint_label.set_text(
                    f"{hint}" if repeats < 3 else
                    f"{hint} That is {repeats} times with the same reason — if "
                    "it keeps repeating, the driver may simply not handle this "
                    "sensor.")
            self._update_tally()
            return

        # Terminal -- fprintd has ended this enrollment.
        self.strip.mark(kind, duration)

        # ...but a driver fault has not ended the SESSION: the claim is still
        # ours. Restart rather than making the user re-authorize, and count it
        # like any other attempt so the tally stays the record. This branch
        # must run before _stop(), which would unsubscribe the signal.
        if kind == "driver" and self._may_restart():
            self.attempts += 1
            self.tally[title] = self.tally.get(title, 0) + 1
            self._add_log(kind, title, hint)
            self._restart_enrollment(title)
            self._update_tally()
            return

        self._stop(release=True)
        if kind == "done":
            self.completed = True
            self.passed = self.stages
            self.dots.set_passed(self.stages)
            self.count_label.set_text(f"{self.stages} / {self.stages}")
            self.status_label.set_text("Enrolled")
            self.hint_label.set_text(
                f"{self.label} is stored. Close this window; the panel's "
                "hyprlock switch can be turned on now.")
            self._add_log("done", "Enrolled", self.label)
            self._toast("Finger enrolled", timeout=6)
        else:
            self.status_label.set_text(title)
            # The terminal driver branch gets the same "not your gesture"
            # framing as the retry branch above. This is the message the user
            # is left staring at when the run dies, so it is the one that most
            # needs to say whose problem it is.
            if kind == "driver":
                blocked = self._restart_block or ""
                self.hint_label.set_text(
                    f"{hint} This is not your gesture -- no way of moving the "
                    f"finger gets past it. {blocked}".rstrip())
            else:
                self.hint_label.set_text(hint)
            self._add_log(kind, title, hint)
        self._update_tally()
        self.phase = "idle"
        self._set_stages_note()
        self.cal_button.set_sensitive(True)
        self.start_button.set_sensitive(True)
        self.start_button.set_label("Try again")

    # -- teardown ----------------------------------------------------------- #

    def _may_restart(self):
        """Whether to restart the enrollment ourselves after a driver fault.

        Records WHY it refused in self._restart_block, because "the panel gave
        up" and "the panel decided your gesture was wrong" look identical from
        the outside and only one of them is true.
        """
        if self.restarts >= self.MAX_RESTARTS:
            self._restart_block = (
                f"That is {self.restarts} restarts; stopping here rather than "
                "looping. Nothing about this is your gesture.")
            return False
        if self._dry_restarts >= self.MAX_DRY_RESTARTS:
            self._restart_block = (
                f"{self._dry_restarts} driver faults in a row with no finger "
                "contact between them — the reader looks wedged, which a "
                "restart cannot clear. Close this and run "
                "./fp-debug.sh rebind.")
            return False
        return True

    def _restart_enrollment(self, reason):
        """EnrollStop + EnrollStart, keeping the claim and the subscriptions.

        Must NOT go through _stop(): that disconnects the g-signal handler, and
        the next EnrollStatus would then go nowhere -- the window would look
        hung with nothing in the log, which is worse than stopping. Nothing
        here touches the handlers or the tick.

        What it cannot preserve is the stage count. fprintd discards the
        partial enrollment when the operation fails, so the next EnrollStart
        genuinely starts at zero. The UI says that out loud rather than
        resetting quietly, which would read as a glitch.
        """
        self.restarts += 1
        self._dry_restarts = 0 if self._contact_since_restart else self._dry_restarts + 1
        self._contact_since_restart = False

        for method, args in (
                ("EnrollStop", None),
                ("EnrollStart", GLib.Variant("(s)", (self.finger,)))):
            try:
                self.device.call_sync(method, args, Gio.DBusCallFlags.NONE,
                                      10000, None)
            except GLib.Error as error:
                self._add_log("driver", f"{method} failed on restart",
                              error.message or "")
                self.status_label.set_text("Could not restart the enrollment")
                self.hint_label.set_text(
                    f"{error.message or ''} The reader may be wedged — close "
                    "this window and run ./fp-debug.sh rebind.")
                self._stop(release=True)
                self.cal_button.set_sensitive(True)
                self.start_button.set_sensitive(True)
                self.start_button.set_label("Try again")
                return

        lost = self.passed
        self.passed = 0
        self.dots.set_passed(0)
        self.count_label.set_text(f"0 / {self.stages or '?'}")
        self.status_label.set_text(
            f"{reason} — restarted ({self.restarts})")
        if lost:
            discarded = (f"fprintd discarded the {lost} stage"
                         f"{'s' if lost != 1 else ''} already captured, so the "
                         f"count is back to 0 of {self.stages or '?'}.")
        else:
            discarded = (f"No stage had passed yet, so the count stays at 0 of "
                         f"{self.stages or '?'}.")
        self.hint_label.set_text(
            "The driver fault ended fprintd's enrollment, not the session. "
            + discarded
            + " The reader is still claimed, so you are not asked for your "
              "password again — keep going. " + self._cycle_hint())
        self._add_log("info", f"Restarted enrollment ({self.restarts})",
                      f"{reason}; fprintd discarded {lost} stage(s)")

    def _on_stop_clicked(self, _button):
        was = self.phase
        self._add_log("info", "Stopped by you", was)
        self._stop(release=True)
        if was == "calibrate":
            ready, scored, window = self._cal_gate()
            self.status_label.set_text("Calibration stopped")
            self.hint_label.set_text(
                "Nothing was written. "
                + ("Your placement is scoring — enroll from it now."
                   if ready else
                   f"{scored} of the last {window} reached the matcher; "
                   "calibrate again when you want to keep measuring."))
        else:
            self.status_label.set_text("Stopped")
            self.hint_label.set_text("Press Enroll to go again.")
        self._idle_buttons()

    def _stop(self, release=True):
        """Unsubscribe, stop whatever is running, release. Safe to call twice.

        INVARIANT: this must run BEFORE anything else resets self.phase -- it
        is the only thing that knows which operation the claim was being used
        for, and stopping the wrong one leaves fprintd's running. Every caller
        pairs it as `_stop(); _idle_buttons()`, never the reverse, because
        _idle_buttons sets phase = "idle".
        """
        was = self.phase if self.phase != "idle" else self._last_phase
        if self.phase != "idle":
            self._last_phase = self.phase
        self.phase = "idle"
        self.running = False
        self.stop_button.set_sensitive(False)
        if self._tick_id is not None:
            GLib.source_remove(self._tick_id)
            self._tick_id = None
        for attr in ("_signal_handler", "_props_handler"):
            handler = getattr(self, attr)
            if handler is not None:
                try:
                    self.device.disconnect(handler)
                except (TypeError, AttributeError):
                    pass
                setattr(self, attr, None)
        if release and self.device is not None and not self._released:
            # Stop the operation this claim was actually being used for. The
            # wrong one raises, which is caught -- but calling only the right
            # one keeps the journal readable, and a leaked claim leaves the
            # next Super+L with no fingerprint at all.
            #
            # `_released` makes a second _stop() a no-op. Without it, the
            # close-request _stop that follows an _idle_buttons found
            # phase == "idle", guessed EnrollStop, and fprintd logged
            # "Device was not claimed before use" for both calls -- a line
            # that reads exactly like a claim leak and is the opposite of one.
            self._released = True
            first = "VerifyStop" if was == "calibrate" else "EnrollStop"
            for method in (first, "Release"):
                try:
                    self.device.call_sync(method, None, Gio.DBusCallFlags.NONE,
                                          5000, None)
                except GLib.Error:
                    pass

    def _on_close_request(self, _window):
        self._closed = True
        self._stop(release=True)
        self.parent._enroll_finished(self.completed)
        return False


class TritonWindow(Adw.ApplicationWindow):

    def __init__(self, application):
        super().__init__(
            application=application,
            title="Triton Panel",
            default_width=840,
            default_height=820,
        )
        self.sampler = Sampler()
        self.ppd = self._ppd_proxy()
        # Set while the poll loop is pushing state into widgets, so the widgets'
        # own change handlers do not treat that as a click from the user.
        self._updating = False
        self._profile_choices = []
        self._build_ui()
        self._refresh()
        GLib.timeout_add_seconds(POLL_SECONDS, self._refresh)
        # Closing the window mid-enrollment must not leave fprintd claimed:
        # the next Super+L would have no fingerprint until the claim times out.
        self.connect("close-request", self._on_close)

    # -- infrastructure ----------------------------------------------------- #

    @staticmethod
    def _ppd_proxy():
        try:
            return Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
                "net.hadess.PowerProfiles", None,
            )
        except GLib.Error:
            return None

    def _on_close(self, _window):
        """Close the enrollment window first so ITS close handler releases the
        reader. A claim left behind means the next Super+L has no fingerprint
        until fprintd times the claim out."""
        window = getattr(self, "_enroll_window", None)
        if window is not None:
            window.close()
        # Same invariant for a test left running: the claim outlives the
        # window otherwise.
        if getattr(self, "_testing", False):
            self._test_end("Window closed.")
        return False

    def _toast(self, message, timeout=5):
        toast = Adw.Toast(title=message)
        toast.set_timeout(timeout)
        self.toasts.add_toast(toast)

    def _helper(self, *arguments):
        """Run triton-ctl through sudo -n. Returns (ok, text)."""
        try:
            done = subprocess.run(
                ["sudo", "-n", HELPER, *arguments],
                capture_output=True, text=True, timeout=8,
            )
        except (OSError, subprocess.SubprocessError) as error:
            return False, str(error)
        if done.returncode == 0:
            return True, done.stdout.strip()
        message = (done.stderr or done.stdout).strip() or f"exit {done.returncode}"
        if "password" in message.lower():
            message = ("triton-ctl has no sudoers rule yet -- install "
                       "triton-panel.sudoers to /etc/sudoers.d/triton-panel")
        return False, message

