class BatteryGraph(Gtk.DrawingArea):
    """Charge over time, with the projection drawn on the SAME time axis.

    The whole point of the picture is the join in the middle: the dashed line
    is literally the solid line's current rate carried forward, so a
    projection that disagrees with the slope you can see is a projection you
    can catch. That only works on one linear axis -- putting history and
    future side by side at different scales would make every slope look alike,
    which is the usual way a battery widget manages to be both pretty and
    useless.

    y is pinned to 0-100%. The temperature graph autoscales because only the
    variation matters there; here the floor IS the question, and autoscaling
    would turn a 2% dip into a cliff and hide how far away empty is.

    Colours are fixed RGB for the same reason as in Graph -- they have to read
    on both libadwaita themes -- while the grid, the axis text and the "now"
    line borrow the widget's own foreground so they follow the theme.
    """

    AXIS_WIDTH = 40
    LEGEND_HEIGHT = 38      # two lines of text
    FOOT_HEIGHT = 16        # the clock labels
    LEVEL = (0.24, 0.68, 0.42)    # charge that is there
    USED = (0.88, 0.56, 0.10)     # charge that has gone
    FUTURE = (0.36, 0.60, 0.96)   # the projection

    def __init__(self):
        super().__init__()
        self.state = None
        self.set_content_height(188)
        self.set_draw_func(self._draw)

    def set_state(self, state):
        self.state = state
        self.queue_draw()

    @staticmethod
    def _time_step(span):
        """A round clock step, so the labels are 23:00 / 23:30 / 00:00 rather
        than whatever the span divides into."""
        for step in (60, 120, 300, 600, 900, 1800, 3600, 7200, 10800, 21600):
            if span / step <= 6:
                return step
        return 43200

    @staticmethod
    def _clock(stamp):
        return time.strftime("%H:%M", time.localtime(stamp))

    def _legend(self, state):
        """(headline, detail). Two lines; the rows below the graph carry the
        rest, so this says only what the picture needs to be readable."""
        arrow = {"discharging": "↓", "charging": "↑"}.get(state["direction"], "=")
        head = [f"{state['percent']:.0f}%"]
        if state["rate_w"] is not None:
            head.append(f"{arrow} {state['rate_w']:.1f} W")
        if state["seconds_left"] is not None:
            left = human_duration(state["seconds_left"])
            head.append(f">{human_duration(BATTERY_PROJECTION_MAX_SECONDS)}"
                        if state["over"] else
                        (f"{left} left" if state["direction"] == "discharging"
                         else f"{left} to {state['target_percent']:.0f}%"))

        delta = state["run_delta_percent"]
        detail = []
        if abs(delta) >= 1.0:
            moved = "used" if delta > 0 else "gained"
            wh = abs(delta) / 100.0 * (state["wh_full"] or 0.0)
            since = self._clock(state["run_start"])
            detail.append(f"{moved} {abs(delta):.0f}% ({wh:.1f} Wh) since {since}"
                          + (" (upower)" if state["seeded"] else ""))
        if state["eta"] is not None and not state["over"]:
            target = state["target_percent"]
            label = ("empty" if state["direction"] == "discharging"
                     else ("full" if target >= 100 else f"{target:.0f}%"))
            detail.append(f"{label} ≈ {self._clock(state['eta'])}")
        if state["average_w"] is not None:
            detail.append(f"avg {state['average_w']:.1f} W")
        if not detail and state["note"]:
            detail.append(state["note"])
        return "   ".join(head), "   ".join(detail)

    def _draw(self, _area, cr, width, height):
        fg = self.get_color()
        cr.select_font_face("monospace")

        def dim(alpha):
            cr.set_source_rgba(fg.red, fg.green, fg.blue, alpha)

        state = self.state
        if state is None or not state.get("points"):
            cr.set_font_size(11)
            dim(0.5)
            cr.move_to(8, height / 2)
            cr.show_text("no battery")
            return

        now = state["now"]
        percent = state["percent"]
        left = state["seconds_left"]
        # Clamped for DRAWING only; the slope is unchanged, the line just
        # leaves the right-hand edge instead of compressing the history into
        # a sliver because the laptop is idling at 3 W.
        drawn = min(left, BATTERY_PROJECTION_MAX_SECONDS) if left else None
        end_percent = (percent + (state["target_percent"] - percent) * (drawn / left)
                       if drawn else percent)

        t0 = min(state["run_start"], now - BATTERY_MIN_PAST_SECONDS)
        t1 = max(now + (drawn or 0.0), now + BATTERY_MIN_FUTURE_SECONDS)
        t1 += (t1 - t0) * 0.05   # the ETA must not sit on the frame
        span = max(60.0, t1 - t0)

        top = self.LEGEND_HEIGHT
        plot_h = max(20.0, height - top - self.FOOT_HEIGHT)
        plot_w = max(20.0, width - self.AXIS_WIDTH - 8)

        def x_of(stamp):
            return self.AXIS_WIDTH + plot_w * (stamp - t0) / span

        def y_of(value):
            return top + plot_h * (1.0 - max(0.0, min(100.0, value)) / 100.0)

        # -- grid ----------------------------------------------------------- #
        cr.set_font_size(11)
        cr.set_line_width(1)
        for value in (0, 20, 40, 60, 80, 100):
            y = y_of(value)
            dim(0.12)
            cr.move_to(self.AXIS_WIDTH, y)
            cr.line_to(width - 8, y)
            cr.stroke()
            dim(0.55)
            cr.move_to(4, y + 4)
            cr.show_text(f"{value:3d}%")

        # The cap, when it is on: the ceiling a charge actually stops at, and
        # the reason "time to full" here means "time to 80%".
        if state["cap_on"]:
            cr.set_source_rgba(*self.USED, 0.75)
            cr.set_dash([3, 3])
            cr.move_to(self.AXIS_WIDTH, y_of(80))
            cr.line_to(width - 8, y_of(80))
            cr.stroke()
            cr.set_dash([])

        points = [(x_of(stamp), y_of(value)) for stamp, value in state["points"]]

        # -- what has been consumed ----------------------------------------- #
        # The band between where the run started and where the charge is now.
        # This is the "cuánta batería se ha consumido" half of the picture:
        # its height is the answer and its width is how long it took.
        base_y = y_of(state["run_start_percent"])
        if abs(state["run_delta_percent"]) >= 0.5:
            cr.move_to(points[0][0], base_y)
            for x, y in points:
                cr.line_to(x, y)
            cr.line_to(points[-1][0], base_y)
            cr.close_path()
            band = self.USED if state["run_delta_percent"] > 0 else self.LEVEL
            cr.set_source_rgba(*band, 0.30)
            cr.fill()
            dim(0.40)
            cr.set_dash([2, 3])
            cr.move_to(points[0][0], base_y)
            cr.line_to(points[-1][0], base_y)
            cr.stroke()
            cr.set_dash([])

        # -- the projection ------------------------------------------------- #
        if drawn:
            x_now, x_end = x_of(now), x_of(now + drawn)
            cr.move_to(x_now, y_of(percent))
            cr.line_to(x_end, y_of(end_percent))
            cr.line_to(x_end, y_of(0))
            cr.line_to(x_now, y_of(0))
            cr.close_path()
            cr.set_source_rgba(*self.FUTURE, 0.10)
            cr.fill()

            cr.set_source_rgba(*self.FUTURE, 0.95)
            cr.set_line_width(1.6)
            cr.set_dash([5, 4])
            cr.move_to(x_now, y_of(percent))
            cr.line_to(x_end, y_of(end_percent))
            cr.stroke()
            cr.set_dash([])

        # -- the charge itself ---------------------------------------------- #
        cr.set_source_rgb(*self.LEVEL)
        cr.set_line_width(1.8)
        cr.move_to(*points[0])
        for x, y in points[1:]:
            cr.line_to(x, y)
        cr.stroke()

        # -- now, and the clock axis ---------------------------------------- #
        x_now = x_of(now)
        dim(0.35)
        cr.set_line_width(1)
        cr.set_dash([2, 2])
        cr.move_to(x_now, top)
        cr.line_to(x_now, top + plot_h)
        cr.stroke()
        cr.set_dash([])

        foot_y = top + plot_h + 12
        taken = []

        def place(stamp, text, keep):
            """A clock label under `stamp`, centred, if it fits.

            `keep` is for the ETA, which is the one label on this axis worth
            the space: it is nudged back inside the widget rather than
            dropped, and the tick drawn above it is what keeps it honest
            about where it points. Every other label is simply skipped when
            it would run off an edge or collide -- a half-drawn clock time is
            worse than none.
            """
            extent = cr.text_extents(text)[4]
            x = x_of(stamp) - extent / 2
            if keep:
                x = max(self.AXIS_WIDTH, min(x, width - 8 - extent))
            elif x < self.AXIS_WIDTH or x + extent > width - 8:
                return
            if any(a < x + extent and x < b for a, b in taken):
                return
            cr.move_to(x, foot_y)
            cr.show_text(text)
            taken.append((x - 6, x + extent + 6))

        if state["eta"] is not None and not state["over"]:
            x_eta = x_of(state["eta"])
            cr.set_source_rgba(*self.FUTURE, 0.95)
            cr.set_line_width(1)
            cr.move_to(x_eta, top + plot_h - 5)
            cr.line_to(x_eta, top + plot_h + 3)
            cr.stroke()
            place(state["eta"], self._clock(state["eta"]), keep=True)

        dim(0.45)
        step = self._time_step(span)
        stamp = math.ceil(t0 / step) * step
        while stamp <= t1:
            place(stamp, self._clock(stamp), keep=False)
            stamp += step

        # -- legend --------------------------------------------------------- #
        head, detail = self._legend(state)
        cr.set_font_size(13)
        cr.set_source_rgb(fg.red, fg.green, fg.blue)
        cr.move_to(self.AXIS_WIDTH, 15)
        cr.show_text(head)
        cr.set_font_size(11)
        dim(0.6)
        cr.move_to(self.AXIS_WIDTH, 31)
        cr.show_text(detail)


