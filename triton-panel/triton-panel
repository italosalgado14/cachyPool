    # -- the poll loop ------------------------------------------------------ #

    def _ppd_state(self):
        """(active profile, note about its driver) from power-profiles-daemon.

        The note matters: until ppd is restarted after predator_v4 appears it
        keeps reporting PlatformDriver "placeholder", which means switching
        profiles moves the intel_pstate EPP and nothing thermal.
        """
        if self.ppd is None:
            return None, "not running"
        active = self.ppd.get_cached_property("ActiveProfile")
        active = active.unpack() if active else None
        profiles = self.ppd.get_cached_property("Profiles")
        note = ""
        if profiles:
            # Asked of the daemon, not of the active profile: ppd omits
            # PlatformDriver entirely from the "performance" entry, so
            # checking only the active profile hid this warning in exactly
            # the case that needs it -- performance selected.
            if any(entry.get("PlatformDriver", "") == "placeholder"
                   for entry in profiles.unpack()):
                note = " — placeholder driver, restart ppd"
        return active, note

    def _refresh(self):
        reading = self.sampler.sample()
        self._updating = True
        try:
            self._apply(reading)
        finally:
            self._updating = False
        return GLib.SOURCE_CONTINUE

    def _apply(self, reading):
        self.temp_graph.push(reading["temps"])
        self.fan_graph.push(
            {name: (float(rpm) if rpm is not None else None)
             for name, rpm in reading["fans"].items()}
        )

        # CPU / memory / GPUs
        cpu = reading["cpu_percent"]
        mhz = reading["cpu_mhz"]
        package = reading["temps"].get("CPU pkg")
        parts = []
        if cpu is not None:
            parts.append(f"{cpu:.0f}%")
            self.cpu_meter.set_value(cpu)
        if mhz:
            parts.append(f"{mhz:.0f} MHz")
        if package:
            parts.append(f"{package:.0f}°C")
        self.cpu_value.set_text("   ".join(parts) or "--")

        memory = reading["memory"]
        if memory:
            self.ram_value.set_text(
                f"{memory['used_gib']:.1f} / {memory['total_gib']:.0f} GiB"
            )
            self.ram_meter.set_value(memory["percent"])
            self.ram_row.set_subtitle(
                f"zram {memory['zram_used_gib']:.2f} / {memory['zram_total_gib']:.0f} GiB"
                " · no disk swap, so no hibernation"
            )

        self.igpu_value.set_text(
            f"{reading['igpu_mhz']} MHz" if reading["igpu_mhz"] else "--"
        )

        dgpu = reading["dgpu"]
        if dgpu is None:
            self.dgpu_value.set_text("--")
            self.dgpu_row.set_subtitle("no NVIDIA device")
        elif "temp_c" in dgpu:
            self.dgpu_value.set_text(
                f"{dgpu['temp_c']:.0f}°C   {dgpu['util_percent']:.0f}%"
                f"   {dgpu['power_w']:.0f} W"
            )
            self.dgpu_row.set_subtitle(f"awake · {dgpu['mem_used_mib']:.0f} MiB in use")
        else:
            self.dgpu_value.set_text(dgpu["status"])
            self.dgpu_row.set_subtitle(
                f"runtime-PM D3 for {dgpu['suspended_minutes']:.0f} min · not polled"
                if dgpu["status"] == "suspended"
                else "awake, but nothing is using it"
            )

        # Platform profile
        choices = reading["platform_choices"]
        if choices != self._profile_choices:
            self._profile_choices = choices
            model = Gtk.StringList()
            for choice in choices:
                model.append(choice)
            self.profile_row.set_model(model)
        self.profile_row.set_sensitive(bool(choices))
        if not choices:
            self.profile_row.set_subtitle(
                "unavailable — acer_wmi needs predator_v4=1"
            )
        else:
            unreachable = [c for c in choices if c not in PPD_FOR_PLATFORM]
            self.profile_row.set_subtitle(
                f"{len(choices)} states; {', '.join(unreachable)} are set directly"
                if unreachable else f"{len(choices)} states"
            )
            current = reading["platform_profile"]
            if current in choices and self.profile_row.get_selected() != choices.index(current):
                self.profile_row.set_selected(choices.index(current))

        active, note = self._ppd_state()
        self.ppd_value.set_text(f"{active or '--'}{note}")

        power = reading["power"]
        source = "AC" if power["ac_online"] else "battery"
        ports = power["usb_pd_ports"]
        if ports:
            source += f" · {ports} USB-C PD source" + ("" if ports == 1 else "s")
        self.source_value.set_text(source)
        self.dock_value.set_text(reading["dock"] or "no dock")

        # Automatic power saving. The switch mirrors the preference file; the
        # value row reports what the daemon actually did, so a disagreement
        # between the two is visible rather than hidden behind the switch.
        self.auto_row.set_active(reading["power_auto"])
        mode = reading["power_mode"]
        if mode is None:
            self.mode_value.set_text("daemon not running")
            self.mode_row.set_subtitle(
                "Start ~/.config/hypr/scripts/power-autoswitch.sh "
                "(exec-once in autostart.conf runs it at login)"
            )
        else:
            rate = mode.get("rate") or "--"
            on_battery = mode.get("source") == "battery"
            # The rate is blank while eDP-1 is disabled, which the 'read'
            # monitor profile does deliberately -- not a fault.
            rate_text = f"{rate} Hz" if rate not in ("", "--") else "panel off"
            if mode.get("auto") == "0":
                self.mode_value.set_text(f"manual · {rate_text}")
                self.mode_row.set_subtitle(
                    "Automation off — the rate is left wherever it is"
                )
            else:
                self.mode_value.set_text(
                    f"{'battery' if on_battery else 'AC'} · {rate_text}"
                )
                saved = mode.get("saved_profile") or ""
                self.mode_row.set_subtitle(
                    f"Saving — will restore {saved} on AC" if on_battery and saved
                    else ("Saving" if on_battery else "Normal")
                )

        # Battery
        battery = reading["battery"]
        if battery is None:
            self.cap_row.set_sensitive(False)
            self.cap_row.set_subtitle("no battery present")
            self.bat_value.set_text("--")
            self.health_value.set_text("--")
        else:
            self.cap_row.set_sensitive(battery["cap"] is not None)
            if battery["cap"] is None:
                self.cap_row.set_subtitle("acer-wmi-battery not loaded")
            else:
                self.cap_row.set_active(battery["cap"] == 1)
                self.cap_row.set_subtitle(
                    "charging stops near 80%" if battery["cap"] == 1
                    else "charges to 100% until the module is reloaded"
                )
            detail = [f"{battery['percent']}%", battery["status"]]
            if battery["power_w"] > 0.05:
                detail.append(f"{battery['power_w']:.1f} W")
            self.bat_value.set_text("   ".join(detail))
            health = []
            if battery["health_percent"]:
                health.append(f"{battery['health_percent']:.0f}% of design")
            if battery["cycles"] is not None:
                health.append(f"{battery['cycles']} cycles")
            if battery["temp_c"]:
                health.append(f"{battery['temp_c']:.1f}°C")
            self.health_value.set_text(" · ".join(health) or "--")

        # Keyboard
        if reading["kbd_available"]:
            self.kbd_row.set_sensitive(True)
            mode = (reading["kbd_mode"] or "").split(",")
            if len(mode) >= 3 and mode[2].isdigit():
                self.kbd_row.set_active(int(mode[2]) > 0)
            self.kbd_row.set_subtitle("four_zoned_kb, static white")
        else:
            self.kbd_row.set_sensitive(False)
            self.kbd_row.set_subtitle(
                "no four_zoned_kb — the in-tree acer_wmi cannot drive the "
                "backlight; needs acer-wmi-linuwu (see README)"
            )

    # -- handlers ----------------------------------------------------------- #

    def _on_wake_dgpu(self, _button):
        live = self.sampler.wake_dgpu_and_read()
        if live is None:
            self._toast("nvidia-smi did not answer")
        else:
            self._toast(
                f"dGPU {live['temp_c']:.0f}°C, {live['util_percent']:.0f}% busy, "
                f"{live['power_w']:.0f} W"
            )

    def _on_profile_selected(self, row, _param):
        if self._updating:
            return
        index = row.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index >= len(self._profile_choices):
            return
        choice = self._profile_choices[index]
        ppd_name = PPD_FOR_PLATFORM.get(choice)
        if ppd_name:
            # Through ppd, so it also applies its intel_pstate EPP.
            try:
                subprocess.run(["powerprofilesctl", "set", ppd_name],
                               capture_output=True, text=True, timeout=8, check=True)
                self._toast(f"Profile {choice} (ppd: {ppd_name})")
            except (OSError, subprocess.SubprocessError) as error:
                self._toast(f"powerprofilesctl failed: {error}")
            return
        ok, message = self._helper("profile", choice)
        if not ok:
            self._toast(message)
            return
        # ppd watches the sysfs file and will relabel itself, which otherwise
        # looks like the panel and ppd disagreeing.
        relabel = "power-saver" if choice == "quiet" else "balanced"
        self._toast(f"Profile {choice} — ppd will now report {relabel}", timeout=7)

    def _on_power_auto_toggled(self, row, _param):
        """Write the preference, then poke the daemon so it acts immediately.

        The poke targets the pid the daemon published. Deliberately NOT
        `pkill -f power-autoswitch.sh`: -f matches whole command lines, so it
        also signals any shell or editor whose argv merely mentions the script.
        If the daemon is not running the preference is still saved and takes
        effect when it next starts.
        """
        if self._updating:
            return
        wanted = row.get_active()
        try:
            os.makedirs(os.path.dirname(POWER_AUTO_PREF), exist_ok=True)
            with open(POWER_AUTO_PREF, "w") as handle:
                handle.write("1" if wanted else "0")
        except OSError as error:
            self._toast(f"could not save the setting: {error}")
            self._updating = True
            row.set_active(not wanted)
            self._updating = False
            return

        state = self.sampler._power_mode()
        pid = (state or {}).get("pid")
        if not pid:
            self._toast(
                "Saved. The power daemon is not running, so this takes effect "
                "when it starts.", timeout=7,
            )
            return
        try:
            os.kill(int(pid), signal.SIGUSR1)
        except (OSError, ValueError):
            self._toast("Saved, but the power daemon did not answer", timeout=7)
            return
        self._toast(
            "Automatic power saving on" if wanted else
            "Automatic power saving off — 240 Hz restored, profile unchanged",
            timeout=6,
        )

    def _on_cap_toggled(self, row, _param):
        if self._updating:
            return
        wanted = row.get_active()
        ok, message = self._helper("cap", "on" if wanted else "off")
        if ok:
            self._toast(
                "Charge cap on — charging stops near 80%" if wanted else
                "Charge cap off. It comes back on the next acer_wmi_battery "
                "load, because /etc/modprobe.d re-sends it.",
                timeout=7,
            )
            return
        self._toast(message, timeout=8)
        # set_active() emits notify::active synchronously, so the guard has to
        # be raised around it. Keep the helper call synchronous: if it ever
        # becomes async, this and _refresh()'s own _updating window stop
        # composing and both need rethinking.
        self._updating = True
        row.set_active(not wanted)
        self._updating = False

    def _on_kbd_toggled(self, row, _param):
        if self._updating:
            return
        wanted = row.get_active()
        ok, message = self._helper("kbd", "on" if wanted else "off")
        if not ok:
            self._toast(message, timeout=8)
            self._updating = True
            row.set_active(not wanted)
            self._updating = False


class TritonApp(Adw.Application):

    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        window = self.props.active_window or TritonWindow(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(TritonApp().run(None))
