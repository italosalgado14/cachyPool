# --------------------------------------------------------------------------- #
# Battery projection constants
# --------------------------------------------------------------------------- #
#
# "How long is left at the current consumption" is three different
# measurements, and conflating them is how a projection ends up lying:
#
#   * the DRAW is instantaneous -- current_now x voltage_now, two seconds
#     apart -- and it is noisy: one sample on 2026-11-02 read 23.2 W while
#     upower's own smoothed figure for the same minute said 30.3 W. Dividing
#     the remaining charge by a raw sample makes the answer jump by half an
#     hour per tick. So the headline rate is an EMA with a ~45 s time
#     constant: still the consumption *now*, without the jitter.
#   * the AVERAGE over the run is the more trustworthy number, but it is a
#     different question ("what has this session been costing"), so it is
#     shown beside the draw and never instead of it.
#   * the HISTORY is what has already been consumed, and most of it predates
#     the panel: this is a Walker-launched window, not a daemon, so its own
#     trace is empty at exactly the moment someone opens it to ask. upower
#     has kept the percent curve since the unplug, which is what the graph is
#     seeded from (see upower_charge_history).
BATTERY_EMA_SECONDS = 45             # time constant of the draw EMA
BATTERY_TRACE_SECONDS = 6 * 3600     # how much of one run the graph keeps
BATTERY_AVG_MIN_SECONDS = 600        # no run average below this much of a run
BATTERY_AVG_MIN_PERCENT = 2.0        # ... nor below this much movement
BATTERY_RATE_FLOOR_W = 0.5           # below this, dividing by it is nonsense
BATTERY_PROJECTION_MAX_SECONDS = 24 * 3600
BATTERY_MIN_PAST_SECONDS = 15 * 60   # the x axis always shows this much past
BATTERY_MIN_FUTURE_SECONDS = 10 * 60 # ... and this much future

# A wall-clock hole larger than this ends the run.
#
# time.monotonic() does NOT advance across s2idle and time.time() jumps, so a
# suspend appears here as a gap -- and a gap is exactly where the drain rate
# and the trace have to restart: the machine was not consuming at its awake
# rate while it slept, and carrying the EMA or the curve across the hole would
# average a sleeping laptop into an awake projection. hypridle suspends this
# machine on battery (hypridle.conf, armed again since the pack came back on
# 2026-10-31), so this is the ordinary case here, not an edge one.
#
# It is deliberately far above 4 x POLL_SECONDS, because the panel's own main
# loop blocks: `sudo -n triton-ctl` waits up to 8 s on every cap or profile
# write, nvidia-smi up to 4 s on "Read now", the upower seed up to 4 s. At a
# tighter threshold one press of a switch was indistinguishable from a resume.
# Nothing moves a 100 Wh pack measurably in 30 s, so the wait costs nothing.
BATTERY_GAP_SECONDS = 30

# upower, used for ONE thing: the part of the curve that happened before the
# panel was opened. Everything live is still read straight from sysfs.
UPOWER_NAME = "org.freedesktop.UPower"
UPOWER_DEVICE = "/org/freedesktop/UPower/devices/battery_" + os.path.basename(BAT)
# upower's own state enum, as returned by GetHistory. 0 is UNKNOWN, which it
# writes as a (timestamp, 0.0, 0) marker wherever it lost track of the device.
UPOWER_STATE = {"charging": 1, "discharging": 2, "full": 4}

# power-profiles-daemon has only three targets, so two of the five platform
# states are unreachable through it and must be written directly.
PPD_FOR_PLATFORM = {
    "low-power": "power-saver",
    "balanced": "balanced",
    "performance": "performance",
}


# --------------------------------------------------------------------------- #
# Fingerprint: fprintd over system D-Bus, and the hyprlock config block
# --------------------------------------------------------------------------- #

def fprint_device():
    """(device proxy, info dict) for the default reader, or (None, None).

    Kept out of the 2 s poll loop on purpose: enrolled prints change only when
    this panel changes them, and ListEnrolledFingers during an enrollment would
    race the EnrollStatus signals.
    """
    try:
        manager = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
            FPRINT_NAME, FPRINT_MANAGER, FPRINT_NAME + ".Manager", None,
        )
        path = manager.call_sync("GetDefaultDevice", None,
                                 Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]
        device = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
            FPRINT_NAME, path, FPRINT_NAME + ".Device", None,
        )
    except GLib.Error:
        return None, None

    def prop(name, default=None):
        value = device.get_cached_property(name)
        return value.unpack() if value is not None else default

    declared = prop("scan-type", "press")
    usb_id, _ = reader_usb()
    area = usb_id in AREA_SENSORS
    return device, {
        "name": prop("name", "fingerprint reader"),
        "stages": prop("num-enroll-stages", 0) or 0,
        # What the driver CLAIMS. "swipe" on the ElanTech sensor here, "press"
        # on most others. Displayed, never used to build an instruction.
        "scan_type": declared,
        "usb_id": usb_id,
        # What the HARDWARE is. Every verb in the UI comes from this. See
        # AREA_SENSORS for why the two can disagree.
        "gesture": "press" if area else declared,
        "driver_scan_type_wrong": area and declared != "press",
    }


def fprint_list(device, username):
    """(fingers, error). fprintd RAISES when nothing is enrolled rather than
    returning an empty list, so that one error is translated to "none" and
    every other error is reported as a real failure."""
    try:
        return list(device.call_sync("ListEnrolledFingers", GLib.Variant("(s)", (username,)),
                                     Gio.DBusCallFlags.NONE, 5000, None).unpack()[0]), None
    except GLib.Error as error:
        text = error.message or ""
        if "NoEnrolledPrints" in text or "discover prints" in text:
            return [], None
        return [], text


def hyprlock_block_state():
    """(enabled, conflict). `conflict` is set when hyprlock.conf already carries
    an auth block the panel did not write -- it then refuses to touch the file
    rather than produce a config with two `auth {` blocks."""
    try:
        text = pathlib.Path(HYPRLOCK_CONF).read_text()
    except OSError:
        return False, None
    outside = text
    if HYPRLOCK_BEGIN in text and HYPRLOCK_END in text:
        i, j = text.index(HYPRLOCK_BEGIN), text.index(HYPRLOCK_END) + len(HYPRLOCK_END)
        outside = text[:i] + text[j:]
        managed = text[i:j]
    else:
        managed = ""
    for line in outside.splitlines():
        stripped = line.strip()
        if stripped.startswith("auth") and ("{" in stripped or stripped.startswith("auth:")):
            return False, "hyprlock.conf already has its own auth block -- edit it by hand"
    return ("enabled = true" in managed), None


def hyprlock_set(enabled, gesture):
    """Add, update or remove the managed block. Atomic (tmp + rename).

    `gesture` is the PHYSICAL gesture (info["gesture"]), not the driver's
    declared scan-type: on this machine those disagree and the driver is the
    one that is wrong, so a block built from scan-type would greet you at the
    lock screen with "Swipe finger to unlock" at a pad you cannot swipe.
    """
    path = pathlib.Path(HYPRLOCK_CONF)
    try:
        text = path.read_text()
    except OSError as error:
        return str(error)
    if HYPRLOCK_BEGIN in text and HYPRLOCK_END in text:
        i, j = text.index(HYPRLOCK_BEGIN), text.index(HYPRLOCK_END) + len(HYPRLOCK_END)
        text = text[:i].rstrip("\n") + text[j:]
        text = text.rstrip("\n") + "\n"
    if enabled:
        verb = "Swipe" if gesture == "swipe" else "Touch"
        text = text.rstrip("\n") + f"""

{HYPRLOCK_BEGIN}
# Written by Triton Panel. hyprlock talks to fprintd over D-Bus directly -- this
# needs no PAM change, which is why unlocking by fingerprint carries none of the
# lockout risk a /etc/pam.d edit would. Password auth stays on regardless.
auth {{
    fingerprint {{
        enabled = true
        ready_message = ({verb} finger to unlock)
        present_message = Scanning fingerprint
        retry_delay = 250
    }}
}}
{HYPRLOCK_END}
"""
    tmp = path.with_suffix(".conf.triton-tmp")
    try:
        tmp.write_text(text)
        tmp.replace(path)
    except OSError as error:
        try:
            tmp.unlink()
        except OSError:
            pass
        return str(error)
    return None


def sudo_has_fprintd():
    try:
        return any(l.strip().startswith("auth") and "pam_fprintd" in l
                   for l in pathlib.Path(SUDO_PAM).read_text().splitlines())
    except OSError:
        return None


# --------------------------------------------------------------------------- #
# sysfs plumbing
# --------------------------------------------------------------------------- #

def read_text(path, default=None):
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError:
        return default


def read_int(path, default=None):
    raw = read_text(path)
    try:
        return int(raw)
    except (TypeError, ValueError):
        return default


def find_hwmon(name):
    """Directory of the hwmon chip called `name`, or None.

    Resolved on every miss rather than cached forever: reloading acer_wmi gives
    its hwmon a brand new index, and the panel should pick that up without a
    restart.
    """
    for candidate in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        if read_text(os.path.join(candidate, "name")) == name:
            return candidate
    return None


def _log(message):
    """Mirror the enrollment log to stderr with a timestamp.

    The panel is launched by the systemd --user manager, so this lands in
    `journalctl --user`. Worth the two lines: the first enrollment failure on
    this machine had to be reconstructed from fprintd's own journal because the
    panel kept its reasoning on screen and nowhere else.
    """
    print(f"[{time.strftime('%H:%M:%S')}] triton-panel/enroll: {message}",
          file=sys.stderr, flush=True)


def reader_usb() -> tuple:
    """(vid:pid, power_control) for the USB fingerprint reader, or (None, None).

    fprintd does not publish the USB id, and the panel needs it to recognise a
    driver/sensor mismatch. Matched on the interface class rather than a
    hardcoded bus path, which moves between boots.
    """
    for path in glob.glob("/sys/bus/usb/devices/*"):
        product = read_text(os.path.join(path, "product"), "") or ""
        if "fingerprint" not in product.lower():
            continue
        vid = read_text(os.path.join(path, "idVendor"), "")
        pid = read_text(os.path.join(path, "idProduct"), "")
        if not vid or not pid:
            continue
        return (f"{vid}:{pid}".lower(),
                read_text(os.path.join(path, "power", "control"), None))
    return None, None


# --------------------------------------------------------------------------- #
# Battery: the run, the draw, and the projection
# --------------------------------------------------------------------------- #

def human_duration(seconds):
    """Seconds as "2 h 05 min" / "47 min". Zero-padded so it does not jiggle."""
    seconds = int(max(0.0, seconds))
    hours, rest = divmod(seconds, 3600)
    minutes = rest // 60
    return f"{hours} h {minutes:02d} min" if hours else f"{minutes} min"


def upower_charge_history(direction, span=BATTERY_TRACE_SECONDS):
    """The percent curve of the CURRENT run, oldest first, from upower.

    Why upower at all, when every other number in this panel is read from
    sysfs: sysfs has no past. This application is a window launched from
    Walker, so its own trace begins empty at precisely the moment someone
    opens it to ask how much battery has gone -- and the answer is in the two
    hours before the window existed. upower keeps that curve in
    /var/lib/upower across launches and is the only record of it. The live
    sample stays on sysfs; upower is consulted once per run, for the history.

    GetHistory("charge", span, points) answers a(udu) -- (unix time, percent,
    state) -- NEWEST FIRST, with state from UPOWER_STATE. It also inserts
    (timestamp, 0.0, 0) markers, state UNKNOWN at a zero percent, wherever it
    lost track of the device, which on this machine means a suspend or an
    upower restart. Those are discontinuities, so the walk backwards stops at
    the first one: the readings on the far side belong to a stretch the
    machine slept through, and stitching them in would draw a seven-hour flat
    segment and then call it consumption. A real example from 2026-11-02:

        (1793667268, 64.0, 2), (1793667268, 0.0, 0), (1793640616, 64.0, 2)

    -- same 64%, 7.4 h apart, the machine asleep in between. The run that is
    still going started at the marker, not at the earlier 64%.
    """
    state = UPOWER_STATE.get(direction)
    if state is None:
        return []
    try:
        proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
            UPOWER_NAME, UPOWER_DEVICE, UPOWER_NAME + ".Device", None,
        )
        reply = proxy.call_sync(
            "GetHistory", GLib.Variant("(suu)", ("charge", int(span), 2048)),
            Gio.DBusCallFlags.NONE, 4000, None,
        )
    except GLib.Error:
        # upower absent, stopped, or refusing: the panel loses the stretch
        # before it was opened and nothing else. Never fatal.
        return []
    return upower_points(reply.unpack()[0], state, time.time(), span)


def upower_points(entries, state, now, span=BATTERY_TRACE_SECONDS):
    """Walk one GetHistory answer back to the start of the current run.

    Separate from the D-Bus call because this is the part with a judgement in
    it -- where a run begins -- and the part a test can hand a recorded
    history to (see test-battery.py, which replays the 2026-11-02 one).
    """
    points = []
    for stamp, percent, kind in entries:
        if kind != state:       # a transition or an UNKNOWN marker: run starts here
            break
        stamp = float(stamp)
        if now - stamp > span:  # ordered, so everything past here is older still
            break
        if stamp > now + 60:    # clock skew; not a reading about this run
            continue
        points.append((stamp, float(percent)))
    points.reverse()
    return points


class BatteryRun:
    """The current discharge (or charge) run: its trace, its rate, its ETA.

    One instance lives in the Sampler and is handed every sample. It owns the
    three things a raw sysfs read cannot give:

      * RUN SEGMENTATION. A run ends when the direction reverses, or at a
        wall-clock hole (BATTERY_GAP_SECONDS -- i.e. a suspend). It does NOT
        end when the status merely goes idle: "Not charging" is what this
        machine reports all day with AC connected and the 80% cap holding, and
        it is also what a brief blip looks like, so wiping the curve there
        would throw away the discharge someone is looking at.
      * THE RATE, smoothed, plus the run average as a cross-check.
      * THE TRACE the graph draws, seeded from upower for the stretch that
        happened before the panel opened.

    Everything it returns is in the units the UI shows, and every field can be
    None -- the panel runs with no battery fitted (as it did for three weeks in
    October 2026) and with the DKMS cap module absent.
    """

    def __init__(self):
        self.started = False
        self.direction = None   # the RUN's direction: discharging / charging / None
        self.live = None        # this sample's direction; None while idle
        self.points = []        # [(wall time, percent)], oldest first
        self.seeded = False     # upower supplied the part before the panel
        self.ema_w = None
        self.last_sample = None
        self.gap = False        # this run began at a suspend hole

    @staticmethod
    def _direction(status):
        """discharging / charging, or None for every idle status.

        None covers "Not charging" (the 80% cap holding with AC on), "Full"
        and "Unknown". Those are not directions and nothing can be projected
        from them, but they are also not the end of a run.
        """
        status = (status or "").strip().lower()
        if status == "discharging":
            return "discharging"
        if status == "charging":
            return "charging"
        return None

    def _start(self, direction, now, percent, after_gap):
        self.started = True
        self.direction = direction
        self.seeded = False
        self.ema_w = None
        self.gap = after_gap
        self.points = []
        # Always ask, including after a gap -- that is what makes a FALSE
        # gap self-healing. A blocking call or an NTP step leaves no marker in
        # upower's history, so it hands back the whole run and the trace is
        # rebuilt instead of lost for the rest of the session; a real suspend
        # does leave one (written at resume, sharing a timestamp with the last
        # point before it), so the walk stops there and returns the stretch
        # since waking, which is the only part worth drawing anyway.
        if direction is not None:
            self.points = upower_charge_history(direction)
            self.seeded = bool(self.points)
        self.points.append((now, percent))

    def update(self, battery):
        """Fold one sample in and return the projection state, or None."""
        if battery is None or battery.get("percent") is None:
            self.__init__()
            return None

        now = time.time()
        percent = float(battery["percent"])
        direction = self._direction(battery.get("status"))
        gap = (self.last_sample is not None
               and abs(now - self.last_sample) > BATTERY_GAP_SECONDS)
        # A reversal only counts between two real directions. idle -> charging
        # is the resumption of a run, not a new one.
        reversed_ = (direction is not None and self.direction is not None
                     and direction != self.direction)

        if not self.started or gap or reversed_:
            self._start(direction, now, percent, after_gap=gap)
        else:
            if direction is not None:
                self.direction = direction
            self._extend(now, percent)

        if direction != self.live:
            # Crossing into or out of idle: the samples before the crossing
            # were measuring something else (0 W at the cap, or a charge
            # current), so the EMA starts over rather than averaging the two.
            self.ema_w = None
        rate = self._rate(battery, now, direction)
        self.live = direction
        self.last_sample = now
        return self._state(battery, now, percent, direction, rate)

    # -- trace -------------------------------------------------------------- #

    def _extend(self, now, percent):
        """Append a point, or just move the last one forward.

        Decimation that loses nothing: while the percentage holds, the final
        point's timestamp is what advances, which extends the flat segment
        instead of filling the list with identical samples. A six-hour
        discharge therefore costs about eighty points, not ten thousand, and
        the newest point is always the live reading.
        """
        if len(self.points) >= 2 and self.points[-1][1] == percent:
            self.points[-1] = (now, percent)
        else:
            self.points.append((now, percent))
        cutoff = now - BATTERY_TRACE_SECONDS
        while len(self.points) > 2 and self.points[0][0] < cutoff:
            self.points.pop(0)

    # -- rate --------------------------------------------------------------- #

    def _rate(self, battery, now, direction):
        """The EMA of the instantaneous draw, in W. None while idle."""
        if direction is None:
            return None
        instant = battery.get("power_w") or 0.0
        if self.ema_w is None:
            self.ema_w = instant
            return self.ema_w
        # dt-aware, so a missed tick (a slow sample, a resume) does not get
        # the weight of a 2 s one.
        elapsed = max(0.0, now - (self.last_sample or now))
        if elapsed > 0.0:
            alpha = 1.0 - math.exp(-min(elapsed, BATTERY_EMA_SECONDS * 4)
                                   / BATTERY_EMA_SECONDS)
            self.ema_w += alpha * (instant - self.ema_w)
        return self.ema_w

    def _average(self, now, wh_full):
        """(W, seconds, delta percent) over the whole trace, or (None, ...).

        Endpoints, not a fit: the trace is quantised to whole percent, so over
        a short window a least-squares slope would be fitting the quantisation
        and not the discharge. The gates below are what make the number mean
        anything -- 2% over 10 minutes is the point where 1% of rounding stops
        dominating the answer.
        """
        if len(self.points) < 2 or not wh_full:
            return None, 0.0, 0.0
        (t0, p0), (t1, p1) = self.points[0], self.points[-1]
        span = t1 - t0
        delta = p0 - p1
        if span < BATTERY_AVG_MIN_SECONDS or abs(delta) < BATTERY_AVG_MIN_PERCENT:
            return None, span, delta
        return abs(delta) / 100.0 * wh_full / (span / 3600.0), span, delta

    # -- the answer --------------------------------------------------------- #

    def _state(self, battery, now, percent, direction, rate):
        wh_now = battery.get("wh_now")
        wh_full = battery.get("wh_full")
        cap_on = battery.get("cap") == 1
        start_time, start_percent = self.points[0]
        average, span, delta = self._average(now, wh_full)

        # Charging stops at the cap, so that -- not 100% -- is what a charge
        # is projected to. charge_full is the right denominator here and
        # charge_full_design is not: this pack reads 101.7 Wh full against a
        # 100.0 Wh design, and a target above the real full would never arrive.
        target = (80.0 if cap_on else 100.0) if direction == "charging" else 0.0

        seconds = None
        note = ""
        if direction is None:
            note = (f"{battery.get('status') or 'idle'} — held at the 80% cap"
                    if cap_on and (battery.get("percent") or 0) >= 75
                    else f"{battery.get('status') or 'idle'} — nothing to project")
        elif rate is None or rate < BATTERY_RATE_FLOOR_W:
            note = f"draw under {BATTERY_RATE_FLOOR_W:g} W — too small to divide by"
        elif wh_now is None or wh_full is None:
            note = "no voltage reading, so no energy figure"
        elif direction == "discharging":
            seconds = wh_now / rate * 3600.0
        else:
            remaining = (target - percent) / 100.0 * wh_full
            if remaining <= 0.0:
                note = f"already at the {target:.0f}% target"
            else:
                seconds = remaining / rate * 3600.0

        over = seconds is not None and seconds > BATTERY_PROJECTION_MAX_SECONDS
        return {
            "direction": direction,
            "status": battery.get("status"),
            "percent": percent,
            "wh_now": wh_now,
            "wh_full": wh_full,
            "used_wh_from_full": (wh_full - wh_now)
                                 if (wh_full and wh_now is not None) else None,
            "cap_on": cap_on,
            "rate_w": rate,
            "average_w": average,
            "run_start": start_time,
            "run_start_percent": start_percent,
            "run_seconds": span,
            "run_delta_percent": delta,
            "seeded": self.seeded,
            "after_gap": self.gap,
            "target_percent": target,
            "seconds_left": seconds,
            "eta": (now + seconds) if seconds is not None else None,
            "over": over,
            "note": note,
            "points": list(self.points),
            "now": now,
        }


class Sampler:
    """One snapshot of the machine per call to `sample()`.

    Every field can be None. The UI is written to expect that, because which
    nodes exist depends on whether predator_v4 is set and whether the DKMS
    battery module is loaded.
    """

    def __init__(self):
        self._acer = None
        self._coretemp = None
        self._prev_cpu = None
        self._dgpu_last = None        # last live reading, reused between polls
        self._dgpu_last_poll = 0.0    # monotonic time of our last nvidia-smi
        self._dgpu_quiet_until = 0.0  # the loop must not touch the GPU before this
        # Carries the battery trace, the drain EMA and the run segmentation
        # across samples; see BatteryRun.
        self._bat_run = BatteryRun()

    # -- chip lookup, revalidated cheaply ----------------------------------- #

    def _chip(self, attr, name):
        path = getattr(self, attr)
        if path is None or not os.path.isdir(path):
            path = find_hwmon(name)
            setattr(self, attr, path)
        return path

    # -- individual readings ------------------------------------------------ #

    def _cpu_percent(self):
        """Whole-CPU busy percentage between this call and the previous one."""
        fields = (read_text("/proc/stat") or "").split("\n")[0].split()
        if len(fields) < 8 or fields[0] != "cpu":
            return None
        values = [int(v) for v in fields[1:8]]
        idle = values[3] + values[4]
        total = sum(values)
        previous, self._prev_cpu = self._prev_cpu, (idle, total)
        if previous is None:
            return None
        idle_delta = idle - previous[0]
        total_delta = total - previous[1]
        if total_delta <= 0:
            return None
        return max(0.0, min(100.0, 100.0 * (1.0 - idle_delta / total_delta)))

    def _cpu_mhz(self):
        freqs = [
            read_int(p)
            for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq")
        ]
        freqs = [f for f in freqs if f]
        return sum(freqs) / len(freqs) / 1000.0 if freqs else None

    def _memory(self):
        info = {}
        for line in (read_text("/proc/meminfo") or "").splitlines():
            key, _, rest = line.partition(":")
            info[key] = int(rest.split()[0]) if rest.split() else 0
        total = info.get("MemTotal", 0)
        available = info.get("MemAvailable", 0)
        swap_total = info.get("SwapTotal", 0)
        swap_free = info.get("SwapFree", 0)
        if not total:
            return None
        return {
            "used_gib": (total - available) / 1048576.0,
            "total_gib": total / 1048576.0,
            "percent": 100.0 * (total - available) / total,
            # Swap here is zram only: there is no disk swap and no resume=, so
            # this machine cannot hibernate.
            "zram_used_gib": (swap_total - swap_free) / 1048576.0,
            "zram_total_gib": swap_total / 1048576.0,
        }

    def _dgpu(self):
        """dGPU state. Never wakes a sleeping GPU, never keeps an idle one up.

        The two sysfs reads are free. nvidia-smi is not: it opens the device, so
        calling it on every tick would hold an otherwise idle 3080 Ti out of
        D3cold indefinitely. Hence the floor and the post-manual-read hold.
        """
        status = read_text(os.path.join(DGPU_PCI, "power/runtime_status"))
        if status is None:
            return None
        suspended_ms = read_int(os.path.join(DGPU_PCI, "power/runtime_suspended_time"), 0)
        state = {"status": status, "suspended_minutes": suspended_ms / 60000.0}
        if status != "active":
            self._dgpu_last = None
            return state

        now = time.monotonic()
        if now >= self._dgpu_quiet_until and now - self._dgpu_last_poll >= DGPU_POLL_SECONDS:
            self._dgpu_last_poll = now
            live = self._dgpu_live()
            if live:
                self._dgpu_last = live
        if self._dgpu_last:
            state.update(self._dgpu_last)
        return state

    def _dgpu_live(self):
        """nvidia-smi, only ever called when the GPU is already awake."""
        try:
            out = subprocess.run(
                [
                    "nvidia-smi",
                    "--query-gpu=temperature.gpu,utilization.gpu,memory.used,power.draw",
                    "--format=csv,noheader,nounits",
                ],
                capture_output=True, text=True, timeout=4, check=True,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return None
        parts = [p.strip() for p in out.split(",")]
        if len(parts) != 4:
            return None
        try:
            return {
                "temp_c": float(parts[0]),
                "util_percent": float(parts[1]),
                "mem_used_mib": float(parts[2]),
                "power_w": float(parts[3]),
            }
        except ValueError:
            return None

    def wake_dgpu_and_read(self):
        """Explicit, user-initiated read -- the only path that may wake the GPU.

        Afterwards the loop is held off, because the GPU this call just woke
        would otherwise read "active" on the very next tick and every tick after
        that would renew its idle timer. The hold lets it fall back to D3.
        """
        live = self._dgpu_live()
        self._dgpu_quiet_until = time.monotonic() + DGPU_MANUAL_HOLD_SECONDS
        self._dgpu_last_poll = self._dgpu_quiet_until
        if live:
            self._dgpu_last = live
        return live

    def _battery(self):
        if not os.path.isdir(BAT):
            return None
        now = read_int(os.path.join(BAT, "charge_now"))
        full = read_int(os.path.join(BAT, "charge_full"))
        design = read_int(os.path.join(BAT, "charge_full_design"))
        current = read_int(os.path.join(BAT, "current_now"), 0) or 0
        voltage = read_int(os.path.join(BAT, "voltage_now"), 0) or 0
        status = read_text(os.path.join(BAT, "status"), "unknown")
        return {
            "percent": read_int(os.path.join(BAT, "capacity")),
            "status": status,
            "cycles": read_int(os.path.join(BAT, "cycle_count")),
            # charge_* is uAh and voltage_now is uV, so the product is pW.
            # current_now's sign convention is not consistent across ACPI
            # implementations, so the direction comes from `status`, not the sign.
            "power_w": abs(current) * voltage / 1e12,
            "health_percent": 100.0 * full / design if full and design else None,
            "wh_now": now * voltage / 1e12 if now and voltage else None,
            # charge_full, NOT charge_full_design: this pack reads 101.7 Wh
            # full against a 100.0 Wh design, and a charge projected to a
            # target above the real full would never arrive.
            #
            # voltage_now, like wh_now above, so the two agree -- and so the
            # voltage cancels in wh_now/power_w, leaving time-to-empty as the
            # charge-over-current it really is. The cost is that both figures
            # sag a watt-hour or two under load and read a little under
            # upower's, which uses the design voltage.
            "wh_full": full * voltage / 1e12 if full and voltage else None,
            # The cap lives on the DKMS module, not on BAT1.
            "cap": read_int(os.path.join(BATTERY_WMI, "health_mode")),
            "temp_c": (
                read_int(os.path.join(BATTERY_WMI, "temperature"), 0) / 1000.0
                if read_text(os.path.join(BATTERY_WMI, "temperature")) else None
            ),
        }

    def _power_source(self):
        """Where the power is coming from.

        Worth a row on this machine: the TB4 dock feeds it over USB-C PD, so
        ACAD can read online with no barrel jack attached. That is the same
        reason anything deciding "on battery?" must look at BAT1/status.
        """
        usb = [
            os.path.basename(p)
            for p in glob.glob("/sys/class/power_supply/ucsi-source-psy-*")
            if read_int(os.path.join(p, "online")) == 1
        ]
        return {
            "ac_online": read_int(os.path.join(AC, "online")),
            "usb_pd_ports": len(usb),
        }

    def _power_mode(self):
        """What power-autoswitch.sh last published, or None if it is not running.

        key=value lines. `ts` is what tells a live daemon from a state file left
        behind by a dead one -- without that check the panel would happily show
        a rate and a mode that nothing is maintaining any more.
        """
        values = {}
        try:
            with open(POWER_STATE) as handle:
                for line in handle:
                    key, _, value = line.partition("=")
                    values[key.strip()] = value.strip()
        except OSError:
            return None
        try:
            age = time.time() - float(values.get("ts", 0))
            stale_after = float(values.get("stale_after", 15))
        except ValueError:
            return None
        if age > stale_after:
            return None
        values["_age"] = age
        return values

    @staticmethod
    def _power_auto_pref():
        """The toggle itself. Absent means ON -- same default as the daemon's."""
        try:
            with open(POWER_AUTO_PREF) as handle:
                return handle.read().strip() != "0"
        except OSError:
            return True

    def _dock(self):
        for device in sorted(glob.glob(os.path.join(THUNDERBOLT, "*-*"))):
            vendor = read_text(os.path.join(device, "vendor_name"))
            model = read_text(os.path.join(device, "device_name"))
            if vendor and model and "INTEL" not in vendor.upper():
                return f"{vendor} {model}"
        return None

    # -- the snapshot ------------------------------------------------------- #

    def sample(self):
        acer = self._chip("_acer", "acer")
        coretemp = self._chip("_coretemp", "coretemp")

        fans = {}
        temps = {}
        if acer:
            fans["Fan 1"] = read_int(os.path.join(acer, "fan1_input"))
            fans["Fan 2"] = read_int(os.path.join(acer, "fan2_input"))
            # temp2_input is wired but reads 0 on this board; skip it.
            for label, node in (("EC 1", "temp1_input"), ("EC 2", "temp3_input")):
                value = read_int(os.path.join(acer, node))
                if value:
                    temps[label] = value / 1000.0
        if coretemp:
            package = read_int(os.path.join(coretemp, "temp1_input"))
            if package:
                temps["CPU pkg"] = package / 1000.0
        for nvme in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
            if read_text(os.path.join(nvme, "name")) == "nvme":
                value = read_int(os.path.join(nvme, "temp1_input"))
                if value:
                    temps.setdefault("NVMe", value / 1000.0)

        igpu_mhz = None
        for node in glob.glob(os.path.join(IGPU_PCI, "drm/card*/gt_cur_freq_mhz")):
            igpu_mhz = read_int(node)
            break

        dgpu = self._dgpu()
        if dgpu and "temp_c" in dgpu:
            temps["dGPU"] = dgpu["temp_c"]

        # Exactly once per sample: the run carries an EMA and a trace, so a
        # second call here would fold the same tick in twice.
        battery = self._battery()
        battery_trend = self._bat_run.update(battery)

        return {
            "acer_available": acer is not None,
            "fans": fans,
            "temps": temps,
            "cpu_percent": self._cpu_percent(),
            "cpu_mhz": self._cpu_mhz(),
            "memory": self._memory(),
            "igpu_mhz": igpu_mhz,
            "dgpu": dgpu,
            "battery": battery,
            "battery_trend": battery_trend,
            "power": self._power_source(),
            "power_mode": self._power_mode(),
            "power_auto": self._power_auto_pref(),
            "dock": self._dock(),
            "platform_profile": read_text(PLATFORM_PROFILE),
            "platform_choices": (read_text(PLATFORM_CHOICES) or "").split(),
            "kbd_available": os.path.isdir(os.path.join(ACER_PLATFORM, "four_zoned_kb")),
            "kbd_mode": read_text(os.path.join(ACER_PLATFORM, "four_zoned_kb/four_zone_mode")),
        }


# --------------------------------------------------------------------------- #
# A small multi-series Cairo plot
# --------------------------------------------------------------------------- #

class Graph(Gtk.DrawingArea):
    """Line chart over the last HISTORY samples.

    Colours are fixed RGB because they have to read on both the light and dark
    libadwaita themes; the axis text and grid borrow the widget's own foreground
    colour so they follow the theme.
    """

    AXIS_WIDTH = 44
    LEGEND_HEIGHT = 18
    GRID_LINES = 5

    def __init__(self, unit, colours, minimum_span):
        super().__init__()
        self.unit = unit
        self.colours = colours
        self.minimum_span = minimum_span  # keeps a flat line from filling the box
        self.series = {}
        self.set_content_height(150)
        self.set_draw_func(self._draw)

    def push(self, values):
        for label in list(self.series) + list(values):
            history = self.series.setdefault(label, [])
            history.append(values.get(label))
            del history[:-HISTORY]
        self.queue_draw()

    @staticmethod
    def _nice_step(span, divisions):
        """A round step -- 1, 2 or 5 times a power of ten.

        Without this the axis is labelled off the raw data range and reads
        0 / 671 / 1341 / 2012, which is hard to compare against at a glance and
        reshuffles every time the maximum moves.

        2.5 is deliberately not on the ladder: the labels are drawn as whole
        numbers, so a 2.5 step prints 38 / 40 / 42 / 45 / 48 / 50 -- gaps that
        look uneven because two of them are rounded.
        """
        rough = span / divisions
        if rough <= 0:
            return 1.0
        magnitude = 10.0 ** math.floor(math.log10(rough))
        for multiple in (1.0, 2.0, 5.0):
            if rough <= magnitude * multiple:
                return magnitude * multiple
        return magnitude * 10.0

    def _bounds(self):
        """(low, high, step), all snapped to the round step."""
        points = [v for h in self.series.values() for v in h if v is not None]
        if not points:
            return None
        low, high = min(points), max(points)
        if high - low < self.minimum_span:
            middle = (high + low) / 2.0
            low, high = middle - self.minimum_span / 2.0, middle + self.minimum_span / 2.0
        step = self._nice_step(high - low, self.GRID_LINES)
        bottom, top = min(points), max(points)
        low = max(0.0, math.floor(low / step) * step)
        high = math.ceil(high / step) * step
        # Snapping alone can land a bound exactly on the data, which draws the
        # trace along the frame. Push that side out by one more step -- except
        # a zero floor, which is where fan RPM genuinely belongs.
        if low >= bottom and low > 0:
            low -= step
        if high <= top:
            high += step
        return low, high, step

    def _draw(self, _area, cr, width, height):
        fg = self.get_color()
        cr.select_font_face("monospace")
        cr.set_font_size(11)

        bounds = self._bounds()
        if bounds is None:
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.5)
            cr.move_to(8, height / 2)
            cr.show_text("no data")
            return
        low, high, step = bounds

        top = self.LEGEND_HEIGHT + 4
        plot_height = height - top - 4
        plot_width = width - self.AXIS_WIDTH - 6

        def y_of(value):
            return top + plot_height * (1.0 - (value - low) / (high - low))

        # Grid and axis labels, placed on the round step rather than on
        # fractions of the range, so the numbers hold still while data moves.
        for index in range(int(round((high - low) / step)) + 1):
            value = low + step * index
            y = y_of(value)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.12)
            cr.set_line_width(1)
            cr.move_to(self.AXIS_WIDTH, y)
            cr.line_to(width - 6, y)
            cr.stroke()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.55)
            cr.move_to(4, y + 4)
            cr.show_text(f"{value:5.0f}")

        # Legend across the top, with each series' latest value.
        x = self.AXIS_WIDTH
        for label, history in self.series.items():
            red, green, blue = self.colours.get(label, (0.6, 0.6, 0.6))
            latest = next((v for v in reversed(history) if v is not None), None)
            text = f"{label} {latest:.0f}{self.unit}" if latest is not None else f"{label} --"
            cr.set_source_rgb(red, green, blue)
            cr.rectangle(x, 4, 8, 8)
            cr.fill()
            cr.move_to(x + 12, 12)
            cr.show_text(text)
            x += 12 + cr.text_extents(text)[4] + 14

        # One polyline per series, breaking the line wherever a sample is missing.
        cr.set_line_width(1.6)
        for label, history in self.series.items():
            red, green, blue = self.colours.get(label, (0.6, 0.6, 0.6))
            cr.set_source_rgb(red, green, blue)
            step = plot_width / max(1, HISTORY - 1)
            drawing = False
            for index, value in enumerate(history):
                if value is None:
                    drawing = False
                    continue
                x = self.AXIS_WIDTH + (index + HISTORY - len(history)) * step
                y = y_of(value)
                if drawing:
                    cr.line_to(x, y)
                else:
                    cr.move_to(x, y)
                    drawing = True
            cr.stroke()


