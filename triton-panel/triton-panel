class TritonWindow(Adw.ApplicationWindow):

    def __init__(self, application):
        super().__init__(
            application=application,
            title="Triton Panel",
            default_width=840,
            default_height=820,
        )
        self.sampler = Sampler()
        self.ppd = self._ppd_proxy()
        # Set while the poll loop is pushing state into widgets, so the widgets'
        # own change handlers do not treat that as a click from the user.
        self._updating = False
        self._profile_choices = []
        self._build_ui()
        self._refresh()
        GLib.timeout_add_seconds(POLL_SECONDS, self._refresh)
        # Closing the window mid-enrollment must not leave fprintd claimed:
        # the next Super+L would have no fingerprint until the claim times out.
        self.connect("close-request", self._on_close)

    # -- infrastructure ----------------------------------------------------- #

    @staticmethod
    def _ppd_proxy():
        try:
            return Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
                "net.hadess.PowerProfiles", "/net/hadess/PowerProfiles",
                "net.hadess.PowerProfiles", None,
            )
        except GLib.Error:
            return None

    def _on_close(self, _window):
        """Release the reader before the window goes. Synchronous on purpose:
        two short D-Bus calls on the main loop, ordered, with no thread to
        outlive the window."""
        if getattr(self, "_enrolling", False) and self.fp_device is not None:
            self._fp_release()
        return False

    def _toast(self, message, timeout=5):
        toast = Adw.Toast(title=message)
        toast.set_timeout(timeout)
        self.toasts.add_toast(toast)

    def _helper(self, *arguments):
        """Run triton-ctl through sudo -n. Returns (ok, text)."""
        try:
            done = subprocess.run(
                ["sudo", "-n", HELPER, *arguments],
                capture_output=True, text=True, timeout=8,
            )
        except (OSError, subprocess.SubprocessError) as error:
            return False, str(error)
        if done.returncode == 0:
            return True, done.stdout.strip()
        message = (done.stderr or done.stdout).strip() or f"exit {done.returncode}"
        if "password" in message.lower():
            message = ("triton-ctl has no sudoers rule yet -- install "
                       "triton-panel.sudoers to /etc/sudoers.d/triton-panel")
        return False, message

