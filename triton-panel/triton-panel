    def _apply_projection(self, trend):
        """The two rows the graph's dashed line is made of.

        They say which number is which on purpose. The draw is an EMA over the
        last ~45 s and is the only one that answers "at the consumption right
        now"; the average is the whole run and answers what the session has
        been costing. When the two disagree the run was not uniform, and both
        being on screen is how that becomes visible instead of being smoothed
        into one authoritative-looking figure.
        """
        if trend is None:
            self.drain_value.set_text("--")
            self.drain_row.set_subtitle("")
            self.left_value.set_text("--")
            self.left_row.set_subtitle("")
            return

        direction = trend["direction"]
        if trend["rate_w"] is None:
            self.drain_value.set_text("--")
            self.drain_row.set_subtitle(trend["note"] or "idle")
        else:
            text = f"{trend['rate_w']:.1f} W"
            if trend["wh_full"]:
                text += f"   {trend['rate_w'] / trend['wh_full'] * 100.0:.1f} %/h"
            self.drain_value.set_text(text)
            detail = [
                ("into the pack" if direction == "charging" else "draw")
                + f", averaged over the last {BATTERY_EMA_SECONDS} s"
            ]
            if trend["average_w"] is not None:
                detail.append(
                    f"{trend['average_w']:.1f} W over the run so far "
                    f"({human_duration(trend['run_seconds'])})"
                )
            self.drain_row.set_subtitle(" · ".join(detail))

        self.left_row.set_title(
            f"Time to {trend['target_percent']:.0f}%" if direction == "charging"
            else "Time left"
        )
        if trend["seconds_left"] is None:
            self.left_value.set_text("--")
            note = trend["note"] or "nothing to project"
        elif trend["over"]:
            self.left_value.set_text(
                "> " + human_duration(BATTERY_PROJECTION_MAX_SECONDS))
            note = ("at this draw the projection runs past a day, which is not "
                    "worth putting a clock time on")
        else:
            self.left_value.set_text(human_duration(trend["seconds_left"]))
            when = time.strftime("%H:%M", time.localtime(trend["eta"]))
            if direction == "charging":
                note = f"full ≈ {when}" if not trend["cap_on"] else (
                    f"≈ {when}, where the cap stops it")
            else:
                note = (f"empty ≈ {when} if the draw holds · the firmware cuts "
                        "off a few % above 0, so read this as the outer edge")
        if trend["after_gap"]:
            # The run restarted at a resume, so the history on screen is only
            # the part since waking. Saying so is cheaper than letting someone
            # wonder where the graph went.
            note += " · the run restarted at a gap in the clock"
        self.left_row.set_subtitle(note)

