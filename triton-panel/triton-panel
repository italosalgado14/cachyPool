# --------------------------------------------------------------------------- #
# Calibration: the verify vocabulary, and what a result actually proves
# --------------------------------------------------------------------------- #
#
# Added 2026-11-01 (see `../runbooks/fingerprint.md` §20o). Enrolment
# finally succeeded that morning -- and `fprintd-verify` then failed 4 times
# out of 4. So the panel could enrol a finger that unlocks nothing, and say
# nothing about it: every signal it showed was an ENROLMENT signal, and
# enrolment passing tells you almost nothing about matching.
#
# Two causes stayed indistinguishable from fprintd's summary journal (§20n):
#
#   H1  the stored template is marginal -- 6 accepted captures with 2
#       rejections on a ~1 cm pad -- so nothing will ever match it;
#   H2  the VERIFY captures are too thin. Verify gets ONE capture per touch
#       where enrolment stitched six, so it is strictly the harder operation
#       and may simply sit under the matcher's floor.
#
# Verify is the only NON-DESTRUCTIVE way to tell them apart -- it writes
# nothing -- which is what the calibration phase runs. The classification
# below turns on a single distinction:
#
#   "scored"    the sensor produced an image AND libfprint extracted minutiae
#               from it, so the matcher ran and returned a number. Both
#               `verify-match` and `verify-no-match` mean this.
#   "rejected"  the capture never reached the matcher at all.
#   "driver"    the device or driver faulted; says nothing about the hand.
#
# WHY THAT SPLIT IS THE USEFUL ONE: a high scored rate with `no-match` every
# time is evidence about the TEMPLATE (H1) -- the hand is delivering readable
# ridges and the stored print is what cannot be matched -- and that is exactly
# the case where re-enrolling is worth doing. A low scored rate is placement
# or the small-sensor ceiling (H2), and re-enrolling from captures that thin
# would just build another unmatchable template.
#
# /!\ "scored" is an INFERENCE about libfprint's flow -- extraction fails ->
# retry, extraction succeeds -> bozorth3 -> match/no-match. It is consistent
# with the 2026-11-01 journal (one `No minutiae found` followed by a
# `verify-no-match` in the same run) but it is NOT confirmed against a
# per-capture minutiae count; `./fp-debug.sh verify` is the only thing that
# would print one. So the UI says "scored", never "good", and the window says
# in as many words what the number is and is not evidence of. If a debug run
# ever contradicts this, the claim is labelled as the inference it is and
# nothing has to be retracted. (This is the §20g mistake in miniature: a
# missing log line is not a measurement.)
VERIFY_RESULTS = {
    "verify-match": (
        "stage", "Matched", "scored",
        "The stored print matched this capture."),
    "verify-no-match": (
        "scored", "Scored, did not match", "scored",
        "The sensor got readable ridges and the matcher scored them below "
        "the threshold. This one is about the stored print, not your hand."),
    "verify-retry-scan": (
        "gesture", "No usable detail", "rejected",
        "The capture had no readable ridges, so the matcher never ran. "
        "Cover more of the pad."),
    "verify-swipe-too-short": (
        "gesture", "Contact too short", "rejected",
        "Stay on the sensor longer -- do not lift partway."),
    "verify-too-fast": (
        "gesture", "Too fast", "rejected",
        "Slow down; the driver needs more frames."),
    "verify-finger-not-centered": (
        "gesture", "Off centre", "rejected",
        "Put the pad of the finger over the middle of the sensor."),
    "verify-remove-and-retry": (
        "gesture", "Lift and retry", "rejected",
        "Take the finger right off the sensor, then go again."),
    "verify-disconnected": (
        "driver", "Reader disconnected", "driver",
        "fprintd reports this for a protocol error too -- on this machine the "
        "sensor has never actually left the USB bus (§20m). Not your hand."),
    "verify-unknown-error": (
        "driver", "Driver fault", "driver",
        "A device or driver error, not a bad gesture. Check "
        "`journalctl -u fprintd`."),
}

# The PHYSICAL sensor, which the driver's scan-type gets wrong here.
#
# fprintd reports scan-type = "swipe" for 04f3:0c4f, and that string comes from
# libfprint's `elan` driver -- the same driver whose intermittent protocol
# errors litter this machine's journal. The part in this chassis was checked by
# eye on 2026-11-01: a ~1 cm
# square in the corner of the touchpad, i.e. an AREA/PRESS pad. A finger cannot
# be slid along it, so "swipe" is not merely unconfirmed (as the docs had it),
# it is WRONG -- and every instruction derived from it was asking for a motion
# the hardware cannot receive.
#
# So the panel keeps both. `scan_type` is what the driver claims: evidence
# about the driver, worth displaying. `gesture` is the physical truth, and it
# is what every instruction and the hyprlock ready_message are built from.
# Keyed by USB id, because that is what identifies the part -- never by the
# driver's own reported name.
#
# This also sharpens the upstream analysis of the sibling 04f3:0903: a press on
# an area pad produces frames with no displacement between them, `elan`'s
# multi-frame motion assembly has nothing to stitch, and extraction ends in
# "No minutiae found" -- which is exactly what this machine's journal shows.
AREA_SENSORS = {"04f3:0c4f"}

ACER_PLATFORM = "/sys/devices/platform/acer-wmi"
PLATFORM_PROFILE = "/sys/firmware/acpi/platform_profile"
PLATFORM_CHOICES = "/sys/firmware/acpi/platform_profile_choices"
